# count-expanded teams (issue #574): one block set per resource type,
# count = 2, near-identical instances distinguished only by
# count.index - the idiom docs/use/migrate.md's manual content-matching
# adoption loop cannot offer for adoption (an indexed instance is never
# matched), unlike live-import which reads identity from state directly.

resource "aws_iam_role" "count_team" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "count_team_inline" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-inline"
  role  = aws_iam_role.count_team[count.index].name
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:ListBucket"]
      Resource = "*"
    }]
  })
}

resource "aws_iam_policy" "count_team_policy" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-policy"
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:*"]
      Resource = "arn:aws:s3:::terralith-shared-bucket/*"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "count_team_managed_attach" {
  count      = 2
  role       = aws_iam_role.count_team[count.index].name
  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess"
}

resource "aws_iam_role_policy_attachment" "count_team_custom_attach" {
  count      = 2
  role       = aws_iam_role.count_team[count.index].name
  policy_arn = aws_iam_policy.count_team_policy[count.index].arn
}

resource "aws_iam_instance_profile" "count_team_profile" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-profile"
  role  = aws_iam_role.count_team[count.index].name
}

