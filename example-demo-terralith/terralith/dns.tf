# dns.tf - generated by tools/terralith-gen (issue #564); the DNS fan-out: one zone, many for_each'd records (issue #574).
# Rewritten in full on every run.

resource "aws_route53_zone" "main" {
  name = "tl.terralith.test"
}

locals {
  dns_records = {
    "host-0000" = { type = "A", value = ["10.60.0.0"] }
    "host-0001" = { type = "CNAME", value = ["target-0001.upstream.example.com."] }
    "host-0002" = { type = "TXT", value = ["v=text0002"] }
    "host-0003" = { type = "A", value = ["10.60.0.3"] }
    "host-0004" = { type = "CNAME", value = ["target-0004.upstream.example.com."] }
    "host-0005" = { type = "TXT", value = ["v=text0005"] }
    "host-0006" = { type = "A", value = ["10.60.0.6"] }
    "host-0007" = { type = "CNAME", value = ["target-0007.upstream.example.com."] }
    "host-0008" = { type = "TXT", value = ["v=text0008"] }
    "host-0009" = { type = "A", value = ["10.60.0.9"] }
  }
}

resource "aws_route53_record" "record" {
  for_each = local.dns_records

  zone_id = aws_route53_zone.main.zone_id
  name    = "${each.key}.${aws_route53_zone.main.name}"
  type    = each.value.type
  ttl     = 300
  records = each.value.value
}

