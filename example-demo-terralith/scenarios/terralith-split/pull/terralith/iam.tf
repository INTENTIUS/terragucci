# iam.tf - generated by tools/terralith-gen (issue #564); the identity layer: team roles/policies/attachments/profiles and each ECS service's execution role.
# Rewritten in full on every run.

resource "aws_iam_role" "count_team" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ec2.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy" "count_team_inline" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-inline"
  role  = aws_iam_role.count_team[count.index].name
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:GetObject", "s3:ListBucket"]
      Resource = "*"
    }]
  })
}

resource "aws_iam_policy" "count_team_policy" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-policy"
  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect   = "Allow"
      Action   = ["s3:*"]
      Resource = "arn:aws:s3:::terralith-shared-bucket/*"
    }]
  })
}

resource "aws_iam_role_policy_attachment" "count_team_managed_attach" {
  count      = 2
  role       = aws_iam_role.count_team[count.index].name
  policy_arn = "arn:aws:iam::aws:policy/ReadOnlyAccess"
}

resource "aws_iam_role_policy_attachment" "count_team_custom_attach" {
  count      = 2
  role       = aws_iam_role.count_team[count.index].name
  policy_arn = aws_iam_policy.count_team_policy[count.index].arn
}

resource "aws_iam_instance_profile" "count_team_profile" {
  count = 2
  name  = "tl-count-team-${format("%04d", count.index)}-profile"
  role  = aws_iam_role.count_team[count.index].name
}

resource "aws_iam_role" "svc_0000_exec_role" {
  name = "tl-svc-0000-exec-role"
  assume_role_policy = jsonencode({
    Version = "2012-10-17"
    Statement = [{
      Effect    = "Allow"
      Action    = "sts:AssumeRole"
      Principal = { Service = "ecs-tasks.amazonaws.com" }
    }]
  })
}

resource "aws_iam_role_policy_attachment" "svc_0000_exec_attach" {
  role       = aws_iam_role.svc_0000_exec_role.name
  policy_arn = "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
}
