# The CLI config Terraform's jobs read (TF_CLI_CONFIG_FILE in terragucci.yml):
# modules.harness.local, the host the catalog's addresses name, is answered by
# the stack's template-registry service (the templates profile), which serves
# this repo's registry files with the X-Terraform-Get header Terraform reads.
# Service discovery is skipped, and no module read leaves the stack.
host "modules.harness.local" {
  services = {
    "modules.v1" = "http://template-registry:8080/@REPO@/v1/modules/"
  }
}
