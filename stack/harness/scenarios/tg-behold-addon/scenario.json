{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "tg-behold-addon",
  "product": "terragucci",
  "claim": "behold/addon-form",
  "title": "behold's Add an add-on form asks for a cache on an app; the request workflow opens the pull request, it applies, and behold's apps read lists the add-on",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://terragucci-reports/hs-tg-behold-addon",
  "limits": {
    "out-of-band": 1200,
    "await-pull": 900
  },
  "steps": [
    {
      "id": "base-applied",
      "do": "out-of-band",
      "label": "the base push applied orders",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "request",
      "do": "out-of-band",
      "label": "behold's form posts the cache add-on for orders to /api/templates/request",
      "command": [
        "stack/harness/check.sh",
        "behold-request",
        "acme/cache/aws",
        "cache",
        "--app",
        "orders",
        "--version",
        "0.3.0",
        "--input",
        "cache_name=hs-tgba-orders-cache",
        "--input",
        "origin_arn=app.bucket_arn"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "pull",
      "do": "await-pull",
      "branch": "request/cache/orders/cache",
      "expect": [
        {
          "pull": {
            "title": "Request: cache for orders from cache 0.3.0",
            "files": [
              "apps/orders/addon-cache.tf"
            ],
            "only": true
          }
        }
      ]
    },
    {
      "id": "planned",
      "do": "out-of-band",
      "label": "the pull request's plan job went green",
      "command": [
        "stack/harness/check.sh",
        "pr-run",
        "request/cache/orders/cache",
        "success"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "review",
      "do": "out-of-band",
      "label": "the reviewer approves the pull request",
      "command": [
        "stack/harness/check.sh",
        "review",
        "request/cache/orders/cache"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "merge",
      "do": "merge",
      "pull": "pull"
    },
    {
      "id": "applied",
      "do": "out-of-band",
      "label": "the merge's wave applied",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "in-state",
      "do": "out-of-band",
      "label": "orders's state holds its bucket and the cache's",
      "command": [
        "stack/harness/check.sh",
        "objects",
        "hs-tg-behold-addon-state",
        "apps/orders/terraform.tfstate",
        "[.[0].resources[]? | select(.type == \"aws_s3_bucket\")] | length == 2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "listed",
      "do": "out-of-band",
      "label": "behold's apps read lists orders with the cache add-on",
      "command": [
        "stack/harness/check.sh",
        "behold-apps",
        "orders",
        "--addon",
        "cache"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1"
    },
    "overlay": "break",
    "note": "overlays/break makes orders a plain root in behold's checkout, so the apps read lists no app orders, the post answers 422 not-an-app, and the request step's exit 0 does not hold"
  }
}
