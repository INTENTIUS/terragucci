{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "tg-template-app",
  "product": "terragucci",
  "claim": "template/app-request",
  "title": "A request names a template, an app and its inputs, and terragucci opens the pull request that adds the app's root, which plans, merges and applies like any other",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://terragucci-reports/hs-tg-template-app",
  "limits": {
    "out-of-band": 1200
  },
  "steps": [
    {
      "id": "base-applied",
      "do": "out-of-band",
      "label": "the base push applied billing",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "request",
      "do": "out-of-band",
      "label": "terragucci request opens the pull request for orders from acme/bucket/aws 1.2.0",
      "command": [
        "stack/harness/check.sh",
        "request",
        "acme/bucket/aws",
        "--name",
        "orders",
        "--version",
        "1.2.0",
        "--input",
        "bucket_name=hs-tga-orders"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "pull",
      "do": "await-pull",
      "branch": "request/bucket/orders",
      "expect": [
        {
          "pull": {
            "title": "Request: orders from bucket 1.2.0",
            "files": [
              "apps/orders/main.tf",
              "apps/orders/backend.tf",
              "apps/orders/providers.tf",
              "apps/orders/versions.tf"
            ],
            "only": true
          }
        }
      ]
    },
    {
      "id": "planned",
      "do": "out-of-band",
      "label": "the pull request's plan job went green",
      "command": [
        "stack/harness/check.sh",
        "pr-run",
        "request/bucket/orders",
        "success"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "review",
      "do": "out-of-band",
      "label": "the reviewer approves the pull request",
      "command": [
        "stack/harness/check.sh",
        "review",
        "request/bucket/orders"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "merge",
      "do": "merge",
      "pull": "pull"
    },
    {
      "id": "applied",
      "do": "out-of-band",
      "label": "the merge's wave applied",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "in-state",
      "do": "out-of-band",
      "label": "orders's state holds its bucket",
      "command": [
        "stack/harness/check.sh",
        "objects",
        "hs-tg-template-app-state",
        "apps/orders/terraform.tfstate",
        "[.[0].resources[]? | select(.type == \"aws_s3_bucket\")] | length == 1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1"
    },
    "overlay": "break",
    "note": "overlays/break marks 1.2.0 yanked in the fixture registry's catalog, so the request is refused with not-active, pushes nothing, and the request step's exit 0 does not hold"
  }
}
