{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "tg-agent-request",
  "product": "terragucci",
  "claim": "template/agent-request",
  "title": "An agent asks for an app over terragucci mcp --propose and gets the same pull request a person's request gets, planned, merged and applied the same way",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://terragucci-reports/hs-tg-agent-request",
  "limits": {
    "out-of-band": 1200
  },
  "steps": [
    {
      "id": "base-applied",
      "do": "out-of-band",
      "label": "the base push applied billing",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "request",
      "do": "out-of-band",
      "label": "an MCP client calls request_from_template on terragucci mcp --propose",
      "command": [
        "stack/harness/check.sh",
        "agent-request",
        "request_from_template",
        "{\"template\":\"acme/bucket/aws\",\"version\":\"1.2.0\",\"name\":\"orders\",\"inputs\":{\"bucket_name\":\"hs-tgag-orders\"}}"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "pull",
      "do": "await-pull",
      "branch": "request/bucket/orders",
      "expect": [
        {
          "pull": {
            "title": "Request: orders from bucket 1.2.0",
            "files": [
              "apps/orders/main.tf",
              "apps/orders/backend.tf",
              "apps/orders/providers.tf",
              "apps/orders/versions.tf"
            ],
            "only": true
          }
        }
      ]
    },
    {
      "id": "planned",
      "do": "out-of-band",
      "label": "the pull request's plan job went green",
      "command": [
        "stack/harness/check.sh",
        "pr-run",
        "request/bucket/orders",
        "success"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "review",
      "do": "out-of-band",
      "label": "the reviewer approves the pull request",
      "command": [
        "stack/harness/check.sh",
        "review",
        "request/bucket/orders"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "merge",
      "do": "merge",
      "pull": "pull"
    },
    {
      "id": "applied",
      "do": "out-of-band",
      "label": "the merge's wave applied",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "in-state",
      "do": "out-of-band",
      "label": "orders's state holds its bucket",
      "command": [
        "stack/harness/check.sh",
        "objects",
        "hs-tg-agent-request-state",
        "apps/orders/terraform.tfstate",
        "[.[0].resources[]? | select(.type == \"aws_s3_bucket\")] | length == 1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1"
    },
    "note": "check.sh starts the server without --propose, which serves no request_from_template, so the call is refused as an unlisted tool and the request step's exit 0 does not hold"
  }
}
