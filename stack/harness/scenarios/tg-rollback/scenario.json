{
  "$schema": "https://intentius.io/chant/schemas/e2e-harness/e2e-scenario/v1/e2e-scenario.schema.json",
  "contract": 1,
  "id": "tg-rollback",
  "product": "terragucci",
  "claim": "release/rollback",
  "title": "After a second release reaches staging, a rollback of staging to the first release waits at staging's gate, then applies the first release's files to staging's root alone",
  "tree": {
    "base": "base",
    "overlays": "overlays"
  },
  "reportUrl": "s3://terragucci-reports/hs-tg-rollback",
  "limits": {
    "out-of-band": 1800
  },
  "steps": [
    {
      "id": "base-applied",
      "do": "out-of-band",
      "label": "the base push applied dev's root",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "notes",
      "do": "open",
      "branch": "notes",
      "overlay": "notes",
      "title": "notes: a change that touches no root"
    },
    {
      "id": "merge-notes",
      "do": "merge",
      "pull": "notes"
    },
    {
      "id": "notes-applied",
      "do": "out-of-band",
      "label": "the merge's pipeline passed, so its commit can be released",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "cut-r1",
      "do": "out-of-band",
      "label": "a release is cut from the merge commit",
      "command": [
        "stack/harness/check.sh",
        "release",
        "cut",
        "r1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "dev-r1",
      "do": "out-of-band",
      "label": "dev, the first environment, deploys it",
      "command": [
        "stack/harness/check.sh",
        "release",
        "first",
        "dev",
        "r1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-waits-r1",
      "do": "out-of-band",
      "label": "a promote of r1 to staging plans staging's root and waits at staging's gate",
      "command": [
        "stack/harness/check.sh",
        "release",
        "promote",
        "staging",
        "r1"
      ],
      "expect": [
        {
          "exit": 3
        }
      ]
    },
    {
      "id": "approve-r1",
      "do": "out-of-band",
      "label": "the reviewer approves staging's release gate",
      "command": [
        "stack/harness/check.sh",
        "release",
        "approve",
        "staging"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-r1",
      "do": "out-of-band",
      "label": "the same promote deploys r1 to staging",
      "command": [
        "stack/harness/check.sh",
        "release",
        "promote",
        "staging",
        "r1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-root-r1",
      "do": "out-of-band",
      "label": "staging's own root applied, with staging's files",
      "command": [
        "stack/harness/check.sh",
        "release",
        "output",
        "envs/staging/net",
        "id",
        "net-staging-v1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "v2",
      "do": "open",
      "branch": "v2",
      "overlay": "v2",
      "title": "net: v2 in every environment"
    },
    {
      "id": "merge-v2",
      "do": "merge",
      "pull": "v2"
    },
    {
      "id": "v2-applied",
      "do": "out-of-band",
      "label": "the merge applied v2 to dev's root",
      "command": [
        "stack/harness/check.sh",
        "main-runs",
        "1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "cut-r2",
      "do": "out-of-band",
      "label": "a second release is cut",
      "command": [
        "stack/harness/check.sh",
        "release",
        "cut",
        "r2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "dev-r2",
      "do": "out-of-band",
      "label": "dev deploys it",
      "command": [
        "stack/harness/check.sh",
        "release",
        "first",
        "dev",
        "r2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-waits-r2",
      "do": "out-of-band",
      "label": "a promote of r2 to staging plans staging's root and waits at staging's gate",
      "command": [
        "stack/harness/check.sh",
        "release",
        "promote",
        "staging",
        "r2"
      ],
      "expect": [
        {
          "exit": 3
        }
      ]
    },
    {
      "id": "approve-r2",
      "do": "out-of-band",
      "label": "the reviewer approves staging's release gate",
      "command": [
        "stack/harness/check.sh",
        "release",
        "approve",
        "staging"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-r2",
      "do": "out-of-band",
      "label": "the same promote deploys r2 to staging",
      "command": [
        "stack/harness/check.sh",
        "release",
        "promote",
        "staging",
        "r2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-root-r2",
      "do": "out-of-band",
      "label": "staging's own root applied, with staging's files",
      "command": [
        "stack/harness/check.sh",
        "release",
        "output",
        "envs/staging/net",
        "id",
        "net-staging-v2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "rollback-waits",
      "do": "out-of-band",
      "label": "a rollback of staging to r1 waits at staging's gate",
      "command": [
        "stack/harness/check.sh",
        "release",
        "rollback",
        "staging",
        "r1"
      ],
      "expect": [
        {
          "exit": 3
        }
      ]
    },
    {
      "id": "approve-rollback",
      "do": "out-of-band",
      "label": "the reviewer approves it",
      "command": [
        "stack/harness/check.sh",
        "release",
        "approve",
        "staging"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "rolled-back",
      "do": "out-of-band",
      "label": "the same rollback deploys r1 to staging",
      "command": [
        "stack/harness/check.sh",
        "release",
        "rollback",
        "staging",
        "r1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "staging-back",
      "do": "out-of-band",
      "label": "staging's root holds r1's value again",
      "command": [
        "stack/harness/check.sh",
        "release",
        "output",
        "envs/staging/net",
        "id",
        "net-staging-v1"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    },
    {
      "id": "dev-kept",
      "do": "out-of-band",
      "label": "dev's root still holds r2's",
      "command": [
        "stack/harness/check.sh",
        "release",
        "output",
        "envs/dev/net",
        "id",
        "net-dev-v2"
      ],
      "expect": [
        {
          "exit": 0
        }
      ]
    }
  ],
  "break": {
    "env": {
      "BREAK": "1"
    },
    "overlay": "break",
    "note": "the merged pull request's components name dev's root for staging, so the deploys under staging apply dev's files and staging's root never holds the release's value"
  }
}
