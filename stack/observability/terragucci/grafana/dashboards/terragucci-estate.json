{
  "annotations": {
    "list": []
  },
  "description": "Roots per project, the binary and terragucci versions they run, the DORA metrics terragucci estate computes, module pins across repos and tips by rule.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [
    {
      "title": "Report index",
      "type": "link",
      "url": "http://localhost:TGPH0FLOCIPORT/terragucci-reports/reports/index.html",
      "icon": "doc",
      "tooltip": "",
      "tags": [],
      "asDropdown": false,
      "targetBlank": true,
      "includeVars": false,
      "keepTime": false
    }
  ],
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Projects",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "table",
      "id": 2,
      "title": "Roots per project",
      "description": "Roots in each project's latest plan or drift run. Each project links to its report index.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project) (last_over_time(terragucci_roots_planned{stage=~\"tf-plan|tf-drift\", project=~\"$project\"}[7d]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "project"
            },
            "properties": [
              {
                "id": "links",
                "value": [
                  {
                    "title": "Report index",
                    "url": "http://localhost:TGPH0FLOCIPORT/terragucci-reports/reports/${__value.raw}/index.html",
                    "targetBlank": true
                  }
                ]
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "id": 3,
      "title": "Versions",
      "description": "The binary, its version and the terragucci release each project's latest run used.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (project, binary, version, service_version) (last_over_time(terragucci_binary_version{project=~\"$project\"}[7d]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Delivery",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Deployments per week",
      "description": "Applied waves per week over the newest eight weeks, as terragucci estate last computed them, by project; * is the estate.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project) (last_over_time(terragucci_dora_deployments_per_week{project=~\"$project\"}[1d]))",
          "legendFormat": "{{project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 6,
      "title": "Lead time",
      "description": "Median time from a change's first plan to its wave applied, by project.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project) (last_over_time(terragucci_dora_lead_time_seconds{project=~\"$project\", segment=\"total\"}[1d]))",
          "legendFormat": "{{project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 7,
      "title": "Change failure rate",
      "description": "Failed applies and applied waves followed by drift, over all applies, by project.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project) (last_over_time(terragucci_dora_change_failure_ratio{project=~\"$project\"}[1d]))",
          "legendFormat": "{{project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 8,
      "title": "Time to restore",
      "description": "Median time from a failed apply or drift found to restored, by project.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 18
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project) (last_over_time(terragucci_dora_restore_seconds{project=~\"$project\"}[1d]))",
          "legendFormat": "{{project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Modules and tips",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 26
      },
      "id": 9,
      "panels": []
    },
    {
      "type": "table",
      "id": 10,
      "title": "Module pins",
      "description": "Each module call's pin, by project and root.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (project, root, module, version) (last_over_time(terragucci_module_pin{project=~\"$project\"}[7d]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "type": "table",
      "id": 11,
      "title": "Tips by rule",
      "description": "Tips the latest run of each project gave, by rule.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 27
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (rule) (max by (project, rule) (last_over_time(terragucci_tips{project=~\"$project\"}[7d])))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    }
  ],
  "refresh": "1m",
  "schemaVersion": 42,
  "tags": [
    "terragucci"
  ],
  "templating": {
    "list": [
      {
        "type": "query",
        "name": "project",
        "label": "Project",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(terragucci_last_run_seconds, project)",
        "definition": "label_values(terragucci_last_run_seconds, project)",
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "options": []
      }
    ]
  },
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "browser",
  "title": "terragucci: Estate",
  "uid": "terragucci-estate",
  "weekStart": ""
}
