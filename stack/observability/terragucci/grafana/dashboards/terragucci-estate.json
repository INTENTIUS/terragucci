        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "count by (project, binary, version, service_version) (last_over_time(terragucci_binary_version{project=~\"$project\"}[7d]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
