    {
      "type": "table",
      "id": 6,
      "title": "Tips by rule",
      "description": "Tips the latest run of each project gave, by rule.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (rule) (max by (project, rule) (last_over_time(terragucci_tips{project=~\"$project\"}[7d])))",
