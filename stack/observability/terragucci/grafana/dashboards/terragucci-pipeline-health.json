            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (terragucci_stage, terragucci_result) (increase(terragucci_spans_calls_total{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[$__range]))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {},
      "fieldConfig": {
