        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum by (le, terragucci_stage, terragucci_project) (rate(terragucci_spans_duration_seconds_bucket{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "{{terragucci_stage}} {{terragucci_project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
