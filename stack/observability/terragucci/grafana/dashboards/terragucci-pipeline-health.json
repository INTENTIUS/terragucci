      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 10
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "histogram_quantile(0.5, sum by (le, terragucci_stage, terragucci_project) (rate(terragucci_spans_duration_seconds_bucket{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[$__rate_interval])))",
          "legendFormat": "{{terragucci_stage}} {{terragucci_project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 6,
