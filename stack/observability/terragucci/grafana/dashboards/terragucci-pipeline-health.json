{
  "annotations": {
    "list": []
  },
  "description": "Runs, errors and duration per stage and project, from the stage spans.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "links": [],
  "panels": [
    {
      "type": "row",
      "collapsed": false,
      "title": "Rate and errors",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "id": 1,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 2,
      "title": "Runs per hour",
      "description": "Stage runs per hour, by stage and project.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "sum by (terragucci_stage, terragucci_project) (increase(terragucci_spans_calls_total{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[1h]))",
          "legendFormat": "{{terragucci_stage}} {{terragucci_project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "id": 3,
      "title": "Errors",
      "description": "Share of stage runs that failed, by stage and project.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "(\nsum by (terragucci_stage, terragucci_project) (rate(terragucci_spans_calls_total{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\", status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))\nor\nsum by (terragucci_stage, terragucci_project) (rate(terragucci_spans_calls_total{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[$__rate_interval])) * 0\n)\n/\nsum by (terragucci_stage, terragucci_project) (rate(terragucci_spans_calls_total{terragucci_stage=~\"$stage\", terragucci_project=~\"$project\"}[$__rate_interval]))",
          "legendFormat": "{{terragucci_stage}} {{terragucci_project}}"
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0
        },
        "overrides": []
      }
    },
    {
      "type": "row",
      "collapsed": false,
      "title": "Duration",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "id": 4,
      "panels": []
    },
    {
      "type": "timeseries",
      "id": 5,
      "title": "Duration p50",
