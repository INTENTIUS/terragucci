{
  "name": "@intentius/terragucci",
  "version": "0.2.0",
  "description": "The whole Terraform lifecycle, handled: one config file, generated pipelines for GitHub, GitLab and Forgejo.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/terragucci.git",
    "directory": "packages/terragucci"
  },
  "homepage": "https://intentius.io/terragucci/",
  "bin": {
    "terragucci": "./dist/terragucci.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    },
    "./report.schema.json": "./dist/report.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/types.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs"
  },
  "peerDependencies": {
    "@intentius/tsad-reference": "2.x",
    "@cdktn/hcl2json": "0.x"
  },
  "peerDependenciesMeta": {
    "@intentius/tsad-reference": {
      "optional": true
    },
    "@cdktn/hcl2json": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cdktn/hcl2json": "0.24.0",
    "@intentius/chant": "0.106.4",
    "@intentius/chant-lexicon-forgejo": "0.106.4",
    "@intentius/chant-lexicon-github": "0.106.4",
    "@intentius/chant-lexicon-gitlab": "0.106.4",
    "@intentius/chant-lexicon-terraform": "0.106.4",
    "@intentius/tsad-reference": "2.1.0"
  }
}
