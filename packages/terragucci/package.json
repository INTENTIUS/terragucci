{
  "name": "@intentius/terragucci",
  "version": "0.4.53",
  "description": "Terraform ops and governance.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INTENTIUS/terragucci.git",
    "directory": "packages/terragucci"
  },
  "homepage": "https://intentius.io/terragucci/",
  "bin": {
    "terragucci": "dist/terragucci.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/types.d.ts"
    },
    "./report.schema.json": "./dist/report.schema.json",
    "./notify.schema.json": "./dist/notify.schema.json",
    "./terragucci.schema.json": "./dist/terragucci.schema.json",
    "./workspace-kinds": "./workspace-kinds.json"
  },
  "files": [
    "dist",
    "workspace-kinds.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "types": "./dist/types.d.ts",
  "scripts": {
    "build": "node ../../scripts/build-cli.mjs"
  },
  "dependencies": {
    "@intentius/chant": "0.124.91"
  },
  "peerDependencies": {
    "@intentius/tsad-reference": "2.x",
    "@cdktn/hcl2json": "0.x"
  },
  "peerDependenciesMeta": {
    "@intentius/tsad-reference": {
      "optional": true
    },
    "@cdktn/hcl2json": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cdktn/hcl2json": "0.24.0",
    "@intentius/chant-lexicon-forgejo": "0.124.91",
    "@intentius/chant-lexicon-github": "0.124.91",
    "@intentius/chant-lexicon-gitlab": "0.124.91",
    "@intentius/chant-lexicon-terraform": "0.124.91",
    "@intentius/tsad-reference": "2.1.0",
    "@modelcontextprotocol/sdk": "1.30.1"
  },
  "chantBundleCheck": {
    "bundle": "dist/terragucci.mjs",
    "maxBytes": 2359296,
    "needs": [
      "@intentius/chant"
    ],
    "optional": [
      "@intentius/tsad-reference",
      "@cdktn/hcl2json"
    ],
    "metafile": "../../node_modules/.cache/terragucci/metafile.json",
    "deny": [
      {
        "pattern": "^typescript/",
        "what": "the TypeScript compiler"
      },
      {
        "pattern": "^@intentius/chant/src/lint/",
        "what": "chant lint rules"
      },
      {
        "pattern": "^@intentius/chant/src/codegen/",
        "what": "chant codegen"
      },
      {
        "pattern": "^@intentius/chant/src/cli/",
        "what": "the chant CLI"
      },
      {
        "pattern": "^@intentius/chant-lexicon-[^/]+/src/(index|plugin)\\.ts$",
        "what": "a lexicon entry point"
      },
      {
        "pattern": "^@intentius/chant-lexicon-[^/]+/src/lint/rules/",
        "what": "lexicon lint rules"
      },
      {
        "pattern": "^@intentius/chant-lexicon-[^/]+/src/codegen/",
        "what": "lexicon codegen"
      },
      {
        "pattern": "^@intentius/chant-lexicon-(grafana|prometheus|otel)/",
        "what": "a dashboards lexicon"
      },
      {
        "pattern": "^js-yaml/",
        "what": "js-yaml"
      },
      {
        "pattern": "^@lezer/|^@prometheus-io/",
        "what": "the PromQL parser"
      },
      {
        "pattern": "(^|/)packages/terragucci/src/dashboards/index\\.ts$",
        "what": "the dashboards' declarations"
      },
      {
        "pattern": "^ajv(-formats)?/",
        "what": "Ajv"
      }
    ]
  }
}
