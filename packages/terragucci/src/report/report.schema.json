{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intentius.io/terragucci/schemas/report/v1/report.schema.json",
  "title": "terragucci.report/v1",
  "description": "One terragucci run's plan report. A minor version only adds fields.",
  "type": "object",
  "required": ["schema", "minor", "run", "change_set", "unit", "units", "totals", "groups", "roots", "waves", "named", "holes", "redaction"],
  "properties": {
    "schema": { "const": "terragucci.report/v1" },
    "minor": { "type": "integer", "minimum": 0 },
    "run": {
      "type": "object",
      "required": ["project", "commit", "stage", "binary", "runtime", "started", "finished"],
      "properties": {
        "project": { "type": "string" },
        "commit": { "type": "string" },
        "base": { "type": "string" },
        "stage": { "enum": ["tf-plan", "tf-apply", "tf-drift"] },
        "wave": { "type": "integer" },
        "binary": { "type": "string" },
        "runtime": { "type": "string" },
        "started": { "type": "string" },
        "finished": { "type": "string" },
        "job_url": { "type": "string" },
        "terragucci": { "type": "string" }
      }
    },
    "change_set": { "type": "string" },
    "unit": { "enum": ["member", "instance"] },
    "units": { "type": "integer" },
    "totals": { "type": "object", "additionalProperties": { "type": "integer" } },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "units", "outlier", "noChanges", "changes", "destroys", "varies", "fold", "why"],
        "properties": {
          "id": { "type": "string" },
          "resource": { "type": "string" },
          "units": { "type": "array", "items": { "type": "string" } },
          "outlier": { "type": "boolean" },
          "noChanges": { "type": "boolean" },
          "changes": { "type": "array", "items": { "$ref": "#/$defs/summaryChange" } },
          "extends": { "type": "string" },
          "plus": { "type": "array", "items": { "$ref": "#/$defs/summaryChange" } },
          "destroys": { "type": "integer" },
          "varies": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["address", "paths"],
              "properties": { "address": { "type": "string" }, "paths": { "type": "array", "items": { "type": "string" } } }
            }
          },
          "fold": { "$ref": "#/$defs/fold" },
          "why": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "roots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "status", "plan_digest", "counts", "plan", "changes", "highlights", "fold", "why"],
        "properties": {
          "path": { "type": "string" },
          "terragrunt": {
            "description": "Set when the root is a Terragrunt unit (minor 1).",
            "type": "object",
            "required": ["stack", "selection", "provisional", "run_result"],
            "properties": {
              "stack": { "type": "string" },
              "selection": { "type": "string" },
              "provisional": { "type": "boolean" },
              "run_result": { "type": "string" }
            }
          },
          "status": { "enum": ["planned", "failed"] },
          "error": { "type": "string" },
          "plan_digest": { "type": ["string", "null"] },
          "counts": { "type": "object", "additionalProperties": { "type": "integer" } },
          "group": { "type": "string" },
          "plan": {
            "type": "object",
            "properties": { "text": { "type": "string" }, "json": { "type": "string" } }
          },
          "job_url": { "type": "string" },
          "changes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["address", "type", "action", "attributes", "fold"],
              "properties": {
                "address": { "type": "string" },
                "type": { "type": "string" },
                "action": { "$ref": "#/$defs/action" },
                "disruption": { "type": "string" },
                "deposed": { "type": "string" },
                "module": { "type": "string" },
                "index": { "type": ["string", "integer"] },
                "attributes": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "required": ["path"],
                    "properties": {
                      "path": { "type": "string" },
                      "before": {},
                      "after": {},
                      "unknown": { "const": true },
                      "sensitive": { "const": true },
                      "forcesReplacement": { "const": true }
                    }
                  }
                },
                "replace_paths": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "integer"] } } },
                "importing": { "type": "string" },
                "write_only": { "type": "array", "items": { "type": "string" } },
                "kind": { "enum": ["tags", "description", "unknown"] },
                "fold": { "$ref": "#/$defs/fold" },
                "why": { "type": "string" }
              }
            }
          },
          "highlights": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["address", "type", "action", "why"],
              "properties": {
                "address": { "type": "string" },
                "type": { "type": "string" },
                "action": { "$ref": "#/$defs/action" },
                "why": { "type": "string" }
              }
            }
          },
          "fold": { "$ref": "#/$defs/fold" },
          "why": { "type": "array", "items": { "type": "string" } },
          "timings": { "$ref": "#/$defs/rootTimings" }
        }
      }
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["number", "roots", "set_digest", "approval"],
        "properties": {
          "number": { "type": "integer" },
          "roots": { "type": "array", "items": { "type": "string" } },
          "set_digest": { "type": ["string", "null"] },
          "approval": { "enum": ["not-requested", "waiting", "approved", "not-required"] },
          "gate": {
            "type": "object",
            "required": ["branch", "path"],
            "properties": { "branch": { "type": "string" }, "path": { "type": "string" } }
          }
        }
      }
    },
    "named": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root", "action"],
        "properties": {
          "root": { "type": "string" },
          "address": { "type": "string" },
          "type": { "type": "string" },
          "action": { "enum": ["delete", "replace", "refused", "forget", "import"] },
          "deposed": { "type": "string" },
          "replace_paths": { "type": "array", "items": { "type": "array", "items": { "type": ["string", "integer"] } } },
          "reason": { "type": "string" }
        }
      }
    },
    "holes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["root", "address", "reason"],
        "properties": {
          "root": { "type": "string" },
          "address": { "type": "string" },
          "type": { "type": "string" },
          "reason": { "type": "string" }
        }
      }
    },
    "mock_reads": {
      "description": "Terragrunt dependencies that would have planned on mock_outputs (minor 1).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "dependency", "upstream", "reason"],
        "properties": {
          "unit": { "type": "string" },
          "dependency": { "type": "string" },
          "upstream": { "type": "string" },
          "reason": { "enum": ["no-outputs", "partial", "skip-outputs", "disabled"] },
          "keys": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "deferred": {
      "description": "Terragrunt units that plan after the units they wait for apply (minor 1).",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "after", "why", "previewed"],
        "properties": {
          "unit": { "type": "string" },
          "after": { "type": "array", "items": { "type": "string" } },
          "why": { "type": "string" },
          "previewed": { "type": "boolean" }
        }
      }
    },
    "redaction": {
      "type": "object",
      "required": ["marker", "values"],
      "properties": {
        "marker": { "const": "(sensitive, redacted by terragucci)" },
        "values": { "type": "integer" }
      }
    },
    "tips": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule", "message", "url"],
        "properties": {
          "rule": { "type": "string" },
          "root": { "type": "string" },
          "message": { "type": "string" },
          "url": { "type": "string" }
        }
      }
    },
    "timings": {
      "description": "Where the run spent its time, from the binary's spans (minor 2).",
      "type": "object",
      "required": ["roots", "resources"],
      "properties": {
        "roots": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["root", "seconds", "detail"],
            "properties": {
              "root": { "type": "string" },
              "seconds": { "type": "number" },
              "plan_seconds": { "type": "number" },
              "apply_seconds": { "type": "number" },
              "source": { "$ref": "#/$defs/timingSource" },
              "detail": { "$ref": "#/$defs/timingDetail" }
            }
          }
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["root", "address", "ms"],
            "properties": {
              "root": { "type": "string" },
              "address": { "type": "string" },
              "type": { "type": "string" },
              "ms": { "type": "number" }
            }
          }
        },
        "note": { "type": "string" }
      }
    }
  },
  "$defs": {
    "timingDetail": { "enum": ["resources", "aggregate", "none"] },
    "timingSource": { "description": "binary: terragucci timed each run of the binary; terragrunt: from Terragrunt's run report (minor 3).", "enum": ["binary", "terragrunt"] },
    "rootTimings": {
      "description": "Where a root's plan spent its time, from the binary's spans (minor 2).",
      "type": "object",
      "required": ["seconds", "spans", "detail", "resources", "provider_calls", "provider_init", "lock_waits", "aggregates"],
      "properties": {
        "seconds": { "type": "number" },
        "plan_seconds": { "type": "number" },
        "apply_seconds": { "description": "On a tf-apply wave, the binary's apply run alone (minor 3).", "type": "number" },
        "source": { "$ref": "#/$defs/timingSource" },
        "spans": { "type": "integer" },
        "detail": { "$ref": "#/$defs/timingDetail" },
        "note": { "type": "string" },
        "resources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["address", "ms"],
            "properties": {
              "address": { "type": "string" },
              "type": { "type": "string" },
              "action": { "type": "string" },
              "provider": { "type": "string" },
              "ms": { "type": "number" },
              "refresh_ms": { "type": "number" }
            }
          }
        },
        "provider_calls": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["method", "ms"],
            "properties": {
              "method": { "type": "string" },
              "provider": { "type": "string" },
              "type": { "type": "string" },
              "address": { "type": "string" },
              "ms": { "type": "number" }
            }
          }
        },
        "provider_init": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["provider", "count", "ms", "max_ms"],
            "properties": {
              "provider": { "type": "string" },
              "count": { "type": "integer" },
              "ms": { "type": "number" },
              "max_ms": { "type": "number" }
            }
          }
        },
        "lock_waits": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["ms"],
            "properties": {
              "backend": { "type": "string" },
              "operation": { "type": "string" },
              "attempts": { "type": "integer" },
              "ms": { "type": "number" }
            }
          }
        },
        "aggregates": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["of", "count", "detailed", "ms", "max_ms"],
            "properties": {
              "of": { "type": "string" },
              "kind": { "type": "string" },
              "type": { "type": "string" },
              "provider": { "type": "string" },
              "method": { "type": "string" },
              "count": { "type": "integer" },
              "detailed": { "type": "integer" },
              "ms": { "type": "number" },
              "max_ms": { "type": "number" },
              "slowest": { "type": "string" },
              "groups": { "type": "integer" }
            }
          }
        }
      }
    },
    "action": { "enum": ["create", "update", "replace", "delete", "read", "no-op", "forget"] },
    "fold": { "enum": ["open", "folded"] },
    "summaryChange": {
      "type": "object",
      "required": ["line", "action", "count"],
      "properties": {
        "line": { "type": "string" },
        "action": { "$ref": "#/$defs/action" },
        "count": { "type": "integer" },
        "differsFrom": { "type": "string" },
        "differsIn": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
