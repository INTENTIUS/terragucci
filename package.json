{
  "name": "terragucci",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Terraform, OpenTofu and choudoufu lifecycle kit, built on chant.",
  "license": "Apache-2.0",
  "scripts": {
    "lint": "chant lint ci pages ci-red diff-guard image-ci images observability front-door",
    "test": "vitest run --passWithNoTests",
    "lint-docs": "node scripts/lint-docs.mjs"
  },
  "devDependencies": {
    "@intentius/chant": "0.124.88",
    "@intentius/chant-lexicon-aws": "0.124.88",
    "@intentius/chant-lexicon-docker": "0.124.88",
    "@intentius/chant-lexicon-github": "0.124.88",
    "@intentius/chant-lexicon-grafana": "0.124.88",
    "@intentius/chant-lexicon-otel": "0.124.88",
    "@intentius/chant-lexicon-prometheus": "0.124.88",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "sentences": "0.5.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  },
  "workspaces": [
    "packages/*"
  ],
  "chantGenerated": {
    "regenerate": "just ci",
    "renders": [
      { "name": "ci", "run": "npx chant build ci -o {out}/.github/workflows/ci.yml --format yaml", "files": [".github/workflows/ci.yml"] },
      { "name": "pages", "run": "npx chant build pages -o {out}/.github/workflows/pages.yml --format yaml", "files": [".github/workflows/pages.yml"] },
      { "name": "image-ci", "run": "npx chant build image-ci -o {out}/.github/workflows/images.yml --format yaml", "files": [".github/workflows/images.yml"] },
      { "name": "ci-red", "run": "npx chant build ci-red -o {out}/.github/workflows/ci-red.yml --format yaml", "files": [".github/workflows/ci-red.yml"] },
      { "name": "diff-guard", "run": "npx chant build diff-guard -o {out}/.github/workflows/diff-guard.yml --format yaml", "files": [".github/workflows/diff-guard.yml"] },
      { "name": "scale", "run": "npx chant build scale -o {out}/.github/workflows/scale.yml --format yaml", "files": [".github/workflows/scale.yml"] },
      { "name": "green", "run": "npx chant ci workflow --token-secret CI_GREEN_TOKEN --output {out}/.github/workflows/chant-ci-green.yml", "files": [".github/workflows/chant-ci-green.yml"] },
      { "name": "release", "run": "npx chant release workflow --forge github --output {out}/.github/workflows/publish.yml", "files": [".github/workflows/publish.yml"] },
      { "name": "images", "run": "npx chant build images -o {out}/images/compose.yml --format yaml", "files": ["images/Dockerfile.*"] },
      { "name": "observability", "run": "npx chant build observability --lexicon-output otel={out}/stack/observability/collector.yaml --lexicon-output prometheus={out}/stack/observability/prometheus.yml --format yaml", "files": ["stack/observability/collector.yaml", "stack/observability/prometheus.yml"] },
      { "name": "front-door", "run": "npx chant build front-door -o {out}/docs-site/public/reports-front-door.json --format json", "files": ["docs-site/public/reports-front-door.json"] },
      { "name": "dashboards", "run": "npx tsx scripts/render-dashboards.ts --check" }
    ]
  }
}
