{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"]
  },
  "include": [
    "ci/**/*.ts",
    "pages/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/test/**/*.ts",
    "capture/**/*.ts",
    "nightly/**/*.ts",
    "publish/**/*.ts",
    "ci-red/**/*.ts",
    "diff-guard/**/*.ts",
    "observability/**/*.ts",
    "front-door/**/*.ts",
    "scripts/*.ts",
    "workflows/**/*.ts",
    "test/**/*.ts",
    "chant.config.ts",
    "vitest.config.ts"
  ]
}
