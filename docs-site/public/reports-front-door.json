        },
        "Description": "terragucci reports front door: OpenID Connect sign-in on every viewer request",
        "FunctionName": {
          "Ref": "AWS::StackName"
        },
        "Handler": "index.handler",
        "MemorySize": 128,
        "Role": {
          "Fn::GetAtt": [
            "doorRole",
            "Arn"
          ]
        },
        "Runtime": "nodejs22.x",
        "Timeout": 5
      },
      "Type": "AWS::Lambda::Function"
    },
    "doorEdgeVersion": {
      "Properties": {
        "Description": "edge code sha256 67df8b4bd4241bea",
        "FunctionName": {
          "Fn::GetAtt": [
            "doorEdge",
            "Arn"
          ]
        }
      },
      "Type": "AWS::Lambda::Version"
    },
    "doorRole": {
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Statement": [
            {
              "Action": "sts:AssumeRole",
              "Effect": "Allow",
              "Principal": {
                "Service": [
                  "lambda.amazonaws.com",
                  "edgelambda.amazonaws.com"
                ]
              }
            }
          ],
          "Version": "2012-10-17"
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ],
        "Policies": [
          {
            "PolicyDocument": {
              "Statement": [
                {
                  "Action": "secretsmanager:GetSecretValue",
                  "Effect": "Allow",
                  "Resource": [
                    {
                      "Ref": "doorSettings"
                    },
                    {
                      "Fn::Join": [
                        "",
                        [
                          "arn:",
                          {
                            "Ref": "AWS::Partition"
                          },
                          ":secretsmanager:us-east-1:",
                          {
                            "Ref": "AWS::AccountId"
                          },
                          ":secret:",
                          {
                            "Ref": "OidcClientSecretName"
                          },
                          "-*"
                        ]
                      ]
                    }
                  ]
                }
              ],
              "Version": "2012-10-17"
            },
            "PolicyName": "read-settings"
          }
        ]
      },
      "Type": "AWS::IAM::Role"
    },
    "doorSettings": {
      "Properties": {
        "Description": "Settings and session key of the terragucci reports front door",
        "GenerateSecretString": {
          "ExcludePunctuation": true,
          "GenerateStringKey": "sessionKey",
          "PasswordLength": 64,
          "SecretStringTemplate": {
            "Fn::Join": [
              "",
              [
                "{\"issuer\":\"",
                {
                  "Ref": "OidcIssuer"
                },
                "\",\"clientId\":\"",
                {
                  "Ref": "OidcClientId"
                },
                "\",\"clientSecretName\":\"",
                {
                  "Ref": "OidcClientSecretName"
                },
                "\",\"domain\":\"",
                {
                  "Ref": "DomainName"
                },
                "\",\"allowedDomain\":\"",
                {
                  "Ref": "AllowedEmailDomain"
                },
                "\",\"sessionHours\":\"",
                {
                  "Ref": "SessionHours"
                },
                "\"}"
              ]
            ]
          }
        },
        "Name": {
          "Ref": "AWS::StackName"
        }
      },
      "Type": "AWS::SecretsManager::Secret"
    }
  }
}