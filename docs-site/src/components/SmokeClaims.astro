---
// The smoke claims, as last recorded by `just smoke-record`.
import record from '../data/smoke.json';

// `steward` checks the validation stack's own fountain profile, which no
// setting reaches (config refuses runtime: fountain); it waits on #273 and
// stays off the table.
const STACK_ONLY = new Set(['steward']);

const claims = (record.claims as Array<{
	claim: string;
	says: string;
	needs: string | null;
	verdict: string;
	break: string | null;
}>).filter((c) => !STACK_ONLY.has(c.claim));

const result = (c: (typeof claims)[number]) => {
	if (c.verdict === 'pending') return 'not recorded';
	if (c.verdict === 'pass' && c.break === 'caught') return 'passes, and fails when broken';
	if (c.verdict === 'pass') return 'passes';
	return 'fails';
};
---
<div class="tg-smoke not-content">
	<table>
		<thead>
			<tr><th>Check</th><th>What it shows</th><th>Result</th></tr>
		</thead>
		<tbody>
			{claims.map((c) => (
				<tr>
					<td><code>{c.claim}</code></td>
					<td>{c.says}</td>
					<td class={`v-${c.verdict}`}>{result(c)}</td>
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	.tg-smoke {
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	th {
		text-align: left;
		font-weight: 500;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--tg-rule);
	}
	td {
		padding: 0.55rem 0.75rem 0.55rem 0;
		border-bottom: 1px solid var(--tg-rule);
		vertical-align: top;
	}
	code {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		white-space: nowrap;
	}
	.v-pass {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.v-pending {
		color: var(--sl-color-gray-3);
	}
	.v-fail {
		color: var(--tg-warn);
		font-weight: 600;
	}
</style>
