---
// The smoke claims, as last recorded by `just smoke-record`.
import record from '../data/smoke.json';

// `steward` checks the validation stack's own fountain profile, which no
// setting reaches (config refuses runtime: fountain); it waits on #273 and
// stays off the table.
const STACK_ONLY = new Set(['steward']);

type Row = {
	claim: string;
	says: string;
	needs: string | null;
	verdict: string;
	break: string | null;
	forge?: string;
};
const rows = record.claims as Row[];

// A row with no forge is Forgejo's; a GitLab row carries forge: "gitlab" and
// sits in the GitLab column of its claim, which shows only once one exists.
const forgejo = rows.filter((c) => (c.forge ?? 'forgejo') === 'forgejo' && !STACK_ONLY.has(c.claim));
const gitlab = new Map(rows.filter((c) => c.forge === 'gitlab').map((c) => [c.claim, c]));
const claims = [
	...forgejo.map((c) => ({ claim: c.claim, says: c.says, forgejo: c as Row | undefined, gitlab: gitlab.get(c.claim) })),
	...[...gitlab.values()]
		.filter((g) => !forgejo.some((c) => c.claim === g.claim))
		.map((g) => ({ claim: g.claim, says: g.says, forgejo: undefined, gitlab: g })),
];
const withGitlab = gitlab.size > 0;

const result = (c: Row | undefined) => {
	if (!c) return '';
	if (c.verdict === 'pending') return 'not recorded';
	if (c.verdict === 'pass' && c.break === 'caught') return 'passes, and fails when broken';
	if (c.verdict === 'pass') return 'passes';
	return 'fails';
};
---
<div class="tg-smoke not-content">
	<table>
		<thead>
			<tr><th>Check</th><th>What it shows</th>{withGitlab ? <><th>Forgejo</th><th>GitLab</th></> : <th>Result</th>}</tr>
		</thead>
		<tbody>
			{claims.map((c) => (
				<tr>
					<td><code>{c.claim}</code></td>
					<td>{c.says}</td>
					<td class={c.forgejo ? `v-${c.forgejo.verdict}` : ''}>{result(c.forgejo)}</td>
					{withGitlab && <td class={c.gitlab ? `v-${c.gitlab.verdict}` : ''}>{result(c.gitlab)}</td>}
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	.tg-smoke {
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	th {
		text-align: left;
		font-weight: 500;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--tg-rule);
	}
	td {
		padding: 0.55rem 0.75rem 0.55rem 0;
		border-bottom: 1px solid var(--tg-rule);
		vertical-align: top;
	}
	code {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		white-space: nowrap;
	}
	.v-pass {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.v-pending {
		color: var(--sl-color-gray-3);
	}
	.v-fail {
		color: var(--tg-warn);
		font-weight: 600;
	}
</style>
