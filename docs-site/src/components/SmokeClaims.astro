---
// The smoke claims, as last recorded by `just smoke-record`.
import record from '../data/smoke.json';

// `steward` checks the validation stack's own fountain profile, which no
// setting reaches (config refuses runtime: fountain); it waits on #273 and
// stays off the table.
const STACK_ONLY = new Set(['steward']);

type Row = {
	claim: string;
	says: string;
	needs: string | null;
	verdict: string;
	break: string | null;
	forge?: string;
	binary?: string;
};
const rows = record.claims as Row[];

// A row with no forge is Forgejo's and one with no binary is OpenTofu's. A
// GitLab row carries forge: "gitlab", and a Terraform or choudoufu row, run on
// Forgejo, carries binary. Each sits in its own column of its claim, which
// shows only once a row of it exists.
const COLUMNS = [
	{ key: 'forgejo tofu', label: 'Forgejo' },
	{ key: 'forgejo terraform', label: 'Terraform' },
	{ key: 'forgejo choudoufu', label: 'choudoufu' },
	{ key: 'gitlab tofu', label: 'GitLab' },
] as const;
const keyOf = (c: Row) => `${c.forge ?? 'forgejo'} ${c.binary ?? 'tofu'}`;
const byClaim = new Map<string, { claim: string; says: string; cells: Map<string, Row> }>();
for (const c of rows) {
	if (STACK_ONLY.has(c.claim)) continue;
	const entry = byClaim.get(c.claim) ?? { claim: c.claim, says: c.says, cells: new Map<string, Row>() };
	// The OpenTofu row on Forgejo says what the claim shows; another names its own run.
	if (keyOf(c) === 'forgejo tofu') entry.says = c.says;
	entry.cells.set(keyOf(c), c);
	byClaim.set(c.claim, entry);
}
const claims = [...byClaim.values()];
const columns = COLUMNS.filter((col) => col.key === 'forgejo tofu' || rows.some((c) => keyOf(c) === col.key));
const single = columns.length === 1;

const result = (c: Row | undefined) => {
	if (!c) return '';
	if (c.verdict === 'pending') return 'not recorded';
	if (c.verdict === 'pass' && c.break === 'caught') return 'proven';
	if (c.verdict === 'pass') return 'passes';
	return 'fails';
};
---
<div class="tg-smoke not-content">
	<table>
		<thead>
			<tr><th>Check</th><th>What it shows</th>{single ? <th>Result</th> : columns.map((col) => <th>{col.label}</th>)}</tr>
		</thead>
		<tbody>
			{claims.map((c) => (
				<tr>
					<td><code>{c.claim}</code></td>
					<td>{c.says}</td>
					{columns.map((col) => {
						const cell = c.cells.get(col.key);
						// A binary's row that shows something else, such as a refusal, says what.
						return <td class={cell ? `v-${cell.verdict}` : ''}>{result(cell)}{cell?.binary && cell.says !== c.says && <span class="also">{cell.says}</span>}</td>;
					})}
				</tr>
			))}
		</tbody>
	</table>
</div>

<style>
	.tg-smoke {
		overflow-x: auto;
	}
	table {
		width: 100%;
		border-collapse: collapse;
		font-size: 0.9rem;
	}
	th {
		text-align: left;
		font-weight: 500;
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
		padding: 0.5rem 0.75rem 0.5rem 0;
		border-bottom: 1px solid var(--tg-rule);
	}
	td {
		padding: 0.55rem 0.75rem 0.55rem 0;
		border-bottom: 1px solid var(--tg-rule);
		vertical-align: top;
	}
	code {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		white-space: nowrap;
	}
	.also {
		display: block;
		font-size: 0.8rem;
		font-weight: 400;
		color: var(--sl-color-gray-3);
	}
	.v-pass {
		color: var(--sl-color-white);
		font-weight: 500;
	}
	.v-pending {
		color: var(--sl-color-gray-3);
	}
	.v-fail {
		color: var(--tg-warn);
		font-weight: 600;
	}
</style>
