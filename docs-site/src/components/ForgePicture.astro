---
// A picture of a forge's own setting, in the reader's theme. These are taken
// by hand and change only when the forge's page does; the tutorial's views
// are recorded as text (Recorded.astro).
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const pictures = import.meta.glob<{ default: ImageMetadata }>('../assets/forge/*.png', { eager: true });

interface Props {
	name: string;
	alt: string;
}
const { name, alt } = Astro.props;
const pick = (theme: string) => {
	const p = pictures[`../assets/forge/${name}-${theme}.png`];
	if (!p) throw new Error(`no picture ${name}-${theme}.png in src/assets/forge`);
	return p.default;
};
const light = pick('light');
const dark = pick('dark');
---
<figure class="tg-forge not-content">
	<a class="light" href={light.src} title="Open the full-size picture"><Image src={light} alt={alt} widths={[736, 1472]} sizes="(min-width: 50rem) 46rem, 100vw" /></a>
	<a class="dark" href={dark.src} title="Open the full-size picture"><Image src={dark} alt={alt} widths={[736, 1472]} sizes="(min-width: 50rem) 46rem, 100vw" /></a>
</figure>

<style>
	figure {
		margin: 1rem 0 1.5rem;
		border: 1px solid var(--tg-rule);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	a {
		display: block;
	}
	img {
		display: block;
		width: 100%;
		height: auto;
	}
	.light {
		display: none;
	}
	:global(:root[data-theme='light']) .light {
		display: block;
	}
	:global(:root[data-theme='light']) .dark {
		display: none;
	}
</style>
