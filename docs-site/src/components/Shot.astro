---
// A screenshot `just tutorial-capture` took, in the reader's theme.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const shots = import.meta.glob<{ default: ImageMetadata }>('../assets/tutorial/*.png', { eager: true });

interface Props {
	step: string;
	view: string;
	alt: string;
	/** Render nothing until the step has been captured. `just tutorial-check` still fails on the page until it is. */
	optional?: boolean;
}
const { step, view, alt, optional } = Astro.props;
const pick = (theme: string) => {
	const s = shots[`../assets/tutorial/${step}-${view}-${theme}.png`];
	if (!s && !optional) throw new Error(`no screenshot ${step}-${view}-${theme}.png; run just capture ${step}`);
	return s?.default;
};
const light = pick('light');
const dark = pick('dark');
---
{light && dark && (
	<figure class="tg-shot not-content">
		<Image src={light} alt={alt} class="light" widths={[640, 1280]} sizes="(min-width: 50rem) 46rem, 100vw" />
		<Image src={dark} alt={alt} class="dark" widths={[640, 1280]} sizes="(min-width: 50rem) 46rem, 100vw" />
	</figure>
)}

<style>
	figure {
		margin: 1rem 0 1.5rem;
		border: 1px solid var(--tg-rule);
		border-radius: 0.5rem;
		overflow: hidden;
	}
	img {
		display: block;
		width: 100%;
		height: auto;
	}
	.light {
		display: none;
	}
	:global(:root[data-theme='light']) .light {
		display: block;
	}
	:global(:root[data-theme='light']) .dark {
		display: none;
	}
</style>
