---
// The band that says every pipeline feature has run on a local Forgejo, and
// where the GitHub and GitLab proofs are listed.
import Taco from './Taco.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<aside class="tg-validated not-content">
	<p class="claim"><Taco scale={2} />Every pipeline feature has already run on Forgejo.</p>
	<p>
		On a local Forgejo against an AWS emulator, with every property checked holding and broken. The per-forge claims list what has also run on GitHub and GitLab.
	</p>
	<a href={`${base}/reference/validation/`}>How validation works</a>
</aside>

<style>
	.tg-validated {
		border-top: 1px solid var(--tg-rule);
		border-bottom: 1px solid var(--tg-rule);
		padding: 2rem 0;
		display: grid;
		gap: 0.75rem;
	}
	.claim {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.25rem;
		font-family: var(--tg-display);
		font-size: clamp(1.5rem, 3vw, 2rem);
		font-weight: 600;
		color: var(--sl-color-white);
		text-wrap: balance;
	}
	p {
		margin: 0;
		max-width: 60ch;
		color: var(--sl-color-gray-2);
	}
	a {
		color: var(--sl-color-accent-high);
		font-weight: 600;
	}
</style>
