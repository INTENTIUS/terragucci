---
// GENERATED by `npm run sync-homes` in intentius.github.io. Do not edit this copy: edit src/components/ProductHome.astro there and sync again.
// One product's home page top, drawn from src/data/products.mjs: the name, the
// one-liner, what changes, how it fits, a picker of the starting points the
// product lists, the first command and the docs, source and evidence links.
//
// A product with a {version} in its first command must be given `version`
// (for example "v0.2.0"), which the site reads from its own release file at
// build time. The data holds none. The `art` slot takes the site's own logo.
// Styles use Starlight's tokens only, so the block takes each site's palette.
import { PRODUCTS, STARTS } from '../data/products.mjs';

// A mention of another Intentius project is a link.
const PROJECT = /\b(behold|chant|choudoufu|plunge|plywood|terragucci)\b/;
const PROJECTS = new Set(['behold', 'chant', 'choudoufu', 'plunge', 'plywood', 'terragucci']);
const linked = (text: string, self: string) => text.split(PROJECT).map((part) =>
	PROJECTS.has(part) && part !== self ? { name: part, href: `https://intentius.io/${part}/` } : part);

interface Props {
	id: string;
	version?: string;
}
const { id, version } = Astro.props;

const product = PRODUCTS.find((p) => p.id === id);
if (!product) throw new Error(`ProductHome: no product "${id}" in products.mjs`);

const starts = Object.entries(product.starts).map(([key, href]) => {
	if (!(key in STARTS)) throw new Error(`ProductHome: ${id} lists the start "${key}", which STARTS does not define`);
	return { key, label: STARTS[key], href };
});

const lines = (product.first?.cmd ?? []).map((line) => {
	if (!line.includes('{version}')) return line;
	if (!version) throw new Error(`ProductHome: ${id} has {version} in its first command, so the site must pass version`);
	return line.replaceAll('{version}', version);
});
const { docs, source, evidence } = product.links;
const hid = `ph-${product.id}`;
---
<section class="ph not-content" aria-labelledby={`${hid}-name`}>
	<div class="art"><slot name="art" /></div>
	<h1 id={`${hid}-name`} class="name">{product.name}</h1>
	<p class="one">{product.oneLiner}</p>
	{(product.changes || product.fits) && <div class="text">
		{product.changes && <p>{linked(product.changes, id).map((b) => typeof b === 'string' ? b : <a href={b.href}>{b.name}</a>)}</p>}
		{product.fits && <p>{linked(product.fits, id).map((b) => typeof b === 'string' ? b : <a href={b.href}>{b.name}</a>)}</p>}
	</div>}
	{starts.length > 0 && (
		<nav class="starts" aria-labelledby={`${hid}-starts`}>
			<h2 id={`${hid}-starts`}>Where to start</h2>
			<ul>
				{starts.map((s) => <li><a href={s.href}>{s.label}</a></li>)}
			</ul>
		</nav>
	)}
	{product.first && (
	<div class="first">
		<h2 id={`${hid}-first`}>First command</h2>
		<p class="needs">Needs: {product.first.needs}.</p>
		<pre aria-labelledby={`${hid}-first`}><code>{lines.join('\n')}</code></pre>
		<p><a href={product.first.href}>The full steps</a></p>
	</div>
	)}
	<p class="links">
		<a href={docs}>Docs</a>
		<a href={source}>Source</a>
		{evidence && <a href={evidence}>Evidence</a>}
	</p>
</section>

<style>
	.ph {
		display: grid;
		gap: 1rem;
		max-width: 44rem;
		margin: 0 auto;
		padding-block: 1rem;
	}
	.art { display: flex; justify-content: center; }
	.art:empty { display: none; }
	.name { margin: 0; font-size: var(--sl-text-h1); line-height: 1.1; color: var(--sl-color-white); }
	.one { margin: 0; font-size: var(--sl-text-lg); color: var(--sl-color-gray-2); }
	.text p { margin: 0 0 0.75rem; color: var(--sl-color-gray-2); line-height: 1.6; }
	h2 { margin: 0 0 0.5rem; font-size: var(--sl-text-base); color: var(--sl-color-white); }
	.text p:last-child { margin-bottom: 0; }
	.starts ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.5rem; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); }
	.starts li { margin: 0; }
	.starts a {
		display: block;
		height: 100%;
		padding: 0.7rem 0.9rem;
		font-size: var(--sl-text-sm);
		color: var(--sl-color-gray-1);
		text-decoration: none;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 0.5rem;
		background: var(--sl-color-bg-nav, transparent);
	}
	.starts a:hover, .starts a:focus-visible { border-color: var(--sl-color-accent); }
	.needs { margin: 0 0 0.5rem; font-size: var(--sl-text-sm); color: var(--sl-color-gray-3); }
	pre { margin: 0 0 0.5rem; padding: 0.8rem 1rem; overflow-x: auto; font-size: var(--sl-text-sm); border: 1px solid var(--sl-color-gray-5); border-radius: 0.5rem; background: var(--sl-color-black, transparent); }
	.first p:last-child { margin: 0; font-size: var(--sl-text-sm); }
	.links { display: flex; flex-wrap: wrap; gap: 1.25rem; margin: 0; font-size: var(--sl-text-sm); }
</style>
