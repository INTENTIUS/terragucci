---
// What stays exactly as it is, and the three ways in.
const kept = [
	{ what: 'Your code', detail: 'Modules, roots and variables stay where they are.' },
	{ what: 'Your state', detail: 'The backend you configured keeps it.' },
	{ what: 'Your providers', detail: 'Pinned the way you pin them today.' },
];
const binaries = [
	{ name: 'terraform', detail: 'Plain roots, with your backend.' },
	{ name: 'tofu', detail: 'The same stages on OpenTofu.' },
	{ name: 'Terragrunt', detail: 'Units stay units; each dependency layer is its own gated wave, the canary units first.' },
	{ name: 'choudoufu', detail: 'No state file: each resource carries its own tag. tf-check adds a live check that needs no cloud credentials.', href: '/terragucci/guides/use-a-binary/#choudoufu' },
];
---
<div class="tg-keep not-content">
	<dl class="kept">
		{kept.map((k) => (
			<div>
				<dt>{k.what}</dt>
				<dd>{k.detail}</dd>
			</div>
		))}
	</dl>
	<ul class="binaries">
		{binaries.map((b) => (
			<li>
				{b.href ? <a href={b.href}><code>{b.name}</code></a> : <code>{b.name}</code>}
				<span>{b.detail}</span>
			</li>
		))}
	</ul>
</div>

<style>
	.tg-keep {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
		gap: 2rem;
	}
	.kept {
		margin: 0;
		display: grid;
		gap: 1rem;
	}
	.kept div {
		min-width: 0;
	}
	dt {
		font-family: var(--tg-display);
		font-size: 1.3rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	dd {
		margin: 0.15rem 0 0;
		color: var(--sl-color-gray-2);
	}
	.binaries {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		border-top: 1px solid var(--tg-rule);
	}
	.binaries li {
		margin: 0;
		padding: 0.75rem 0;
		border-bottom: 1px solid var(--tg-rule);
		display: grid;
		grid-template-columns: 8.5rem 1fr;
		gap: 1rem;
		align-items: baseline;
		min-width: 0;
	}
	.binaries code {
		font-family: var(--sl-font-mono);
		background: none;
		padding: 0;
		color: var(--tg-accent);
	}
	.binaries span {
		color: var(--sl-color-gray-2);
		font-size: 0.95rem;
	}
	@media (max-width: 30rem) {
		.binaries li {
			grid-template-columns: 1fr;
			gap: 0.2rem;
		}
	}
</style>
