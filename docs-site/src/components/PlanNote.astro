---
// A grouped plan summary as it lands on a pull request: the product's own artefact.
// The taco is the bot's avatar.
import Taco from './Taco.astro';
---
<figure class="tg-note not-content" aria-label="A grouped plan summary on a pull request">
	<header>
		<span class="avatar"><Taco scale="small" /></span>
		<span class="who">terragucci</span>
		<span class="meta">commented on #482 · bump modules/iam to 1.4.0</span>
	</header>
	<div class="body">
		<p class="lead">200 roots planned. 3 groups, 1 destroy.</p>
		<table>
			<tbody>
				<tr><td class="n">180</td><td>identical change <code>~ aws_iam_role.app</code> tags</td></tr>
				<tr><td class="n">15</td><td>the same, plus <code class="replace">-/+ aws_lambda_function.worker</code></td></tr>
				<tr><td class="n">5</td><td>different changes, listed one by one below</td></tr>
			</tbody>
		</table>
		<pre class="diff" aria-label="The group's diff as the binary prints it"><span class="c">  # aws_iam_role.app will be updated in-place</span>
<span class="u">~   resource "aws_iam_role" "app" &#123;</span>
<span class="u">~       tags = &#123;</span>
<span class="r">-           "team" = "payments"</span>
<span class="a">+           "team" = "platform"</span>
        &#125;
        # (12 unchanged attributes hidden)
    &#125;</pre>
		<details class="plans"><summary><code>prod-eu/db</code>: Plan: 0 to add, 1 to change, 1 to destroy.</summary><p>The root's whole plan, as the binary printed it.</p></details>
		<p class="destroy"><span>destroy</span><code>prod-eu/db · aws_db_instance.main</code></p>
		<table class="waves">
			<thead><tr><th>Wave</th><th>Roots</th><th>Approval</th></tr></thead>
			<tbody>
				<tr><td>1</td><td>3</td><td>not-requested</td></tr>
				<tr><td>2</td><td>97</td><td>not-requested</td></tr>
				<tr><td>3</td><td>100</td><td>not-requested</td></tr>
			</tbody>
		</table>
	</div>
</figure>

<style>
	.tg-note {
		margin: 0;
		border: 1px solid var(--tg-rule);
		border-radius: 0.5rem;
		background: var(--tg-panel);
		overflow: hidden;
		font-size: 0.9rem;
		max-width: 100%;
	}
	header {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		align-items: baseline;
		padding: 0.65rem 1rem;
		border-bottom: 1px solid var(--tg-rule);
	}
	.avatar {
		display: inline-grid;
		place-items: center;
		width: 2rem;
		height: 2rem;
		border-radius: 50%;
		background: var(--tg-taco-ground);
		align-self: center;
	}
	.who {
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.meta {
		color: var(--sl-color-gray-3);
		font-size: 0.82rem;
	}
	.body {
		padding: 1rem;
		display: grid;
		gap: 0.75rem;
		overflow-x: auto;
	}
	.lead {
		margin: 0;
		font-family: var(--tg-display);
		font-size: 1.35rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	table {
		border-collapse: collapse;
		width: 100%;
		margin: 0;
		display: table;
	}
	td {
		padding: 0.4rem 0.5rem 0.4rem 0;
		border: none;
		border-bottom: 1px solid var(--tg-rule);
		color: var(--sl-color-gray-2);
		vertical-align: baseline;
	}
	.n {
		font-family: var(--sl-font-mono);
		font-variant-numeric: tabular-nums;
		color: var(--tg-accent);
		width: 3.5rem;
		text-align: right;
		padding-right: 1rem;
	}
	code {
		font-family: var(--sl-font-mono);
		font-size: 0.85em;
		background: none;
		padding: 0;
		color: var(--sl-color-white);
	}
	code.replace {
		color: var(--tg-accent);
	}
	.destroy {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem;
		align-items: baseline;
	}
	.destroy span {
		font-family: var(--sl-font-mono);
		font-size: 0.72rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--tg-warn);
		border: 1px solid var(--tg-warn);
		border-radius: 99rem;
		padding: 0.05rem 0.5rem;
	}
	.destroy code {
		color: var(--tg-warn);
	}
	.diff {
		margin: 0;
		padding: 0.6rem 0.75rem;
		border: 1px solid var(--tg-rule);
		border-radius: 0.35rem;
		font-family: var(--sl-font-mono);
		font-size: 0.78rem;
		line-height: 1.45;
		color: var(--sl-color-gray-2);
		background: none;
		overflow-x: auto;
	}
	.diff .c {
		color: var(--sl-color-gray-3);
	}
	.diff .u {
		color: var(--sl-color-white);
	}
	.diff .r {
		color: var(--tg-warn);
	}
	.diff .a {
		color: var(--tg-accent);
	}
	.plans {
		margin: 0;
		color: var(--sl-color-gray-3);
		font-size: 0.82rem;
	}
	.plans p {
		margin: 0.4rem 0 0;
	}
	.waves th {
		text-align: left;
		padding: 0.3rem 0.5rem 0.3rem 0;
		border: none;
		border-bottom: 1px solid var(--tg-rule);
		color: var(--sl-color-gray-3);
		font-size: 0.78rem;
		font-weight: 400;
	}
	.waves td {
		font-size: 0.82rem;
		color: var(--sl-color-gray-3);
	}
</style>
