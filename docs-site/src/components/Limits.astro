---
// What terragucci does not do, each with its reason, from src/data/rooms.ts.
import { LIMITS } from '../data/rooms';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<table>
	<thead>
		<tr><th>Not here</th><th>Why, and what you use instead</th></tr>
	</thead>
	<tbody>
		{LIMITS.map((l) => (
			<tr>
				<td>{l.label}</td>
				<td>{l.why}{l.href && <> (<a href={`${base}${l.href}`}>more</a>)</>}</td>
			</tr>
		))}
	</tbody>
</table>
