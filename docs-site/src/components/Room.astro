---
// One room of the site, from src/data/rooms.ts: what works, what you can
// count on, what differs and the first step, then the pages to read in order:
// how-to, explanation, reference. A room for a repo shape also lists what
// differs on each binary and forge, since the shape works on all of them.
import { ASSUMED, BINARIES, FORGES, SHAPES, room } from '../data/rooms';

interface Props {
	id: string;
}
const r = room(Astro.props.id);
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const href = (h: string) => `${base}${h}`;
const isShape = SHAPES.some((s) => s.room === r.id);
const elsewhere = isShape
	? [
			...BINARIES.flatMap((b) => b.differs.map((d) => `On ${b.label}: ${d}`)),
			...FORGES.flatMap((f) => f.differs.map((d) => `On ${f.label}: ${d}`)),
		]
	: [];
const differs = [...r.differs, ...elsewhere];
---
<div class="tg-room not-content">
	<p class="lede">{r.lede}</p>
	<div class="cols">
		<section>
			<h2>Works</h2>
			<ul>{r.works.map((w) => <li>{w}</li>)}</ul>
		</section>
		<section>
			<h2>Differs</h2>
			{differs.length ? <ul>{differs.map((d) => <li>{d}</li>)}</ul> : <p>Nothing: it works as every other page describes.</p>}
		</section>
		<section class="first">
			<h2>First step</h2>
			<p><a href={href(r.first.href)}>{r.first.label}</a></p>
		</section>
	</div>
	<slot />
	<section>
		<h2>You can count on</h2>
		<ul class="assumed">{ASSUMED.map((a) => <li><a href={href(a.href)}>{a.label}</a></li>)}</ul>
	</section>
	<section class="read">
		<h2>Then read</h2>
		<dl>
			<dt>To do a task</dt>
			<dd>{r.howto.map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
			<dt>To see why it works this way</dt>
			<dd>{r.explain.map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
			<dt>To look up a detail</dt>
			<dd>{r.reference.map((l) => <a href={href(l.href)}>{l.label}</a>)}</dd>
		</dl>
	</section>
</div>

<style>
	.tg-room {
		display: grid;
		gap: 2rem;
	}
	.lede {
		margin: 0;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-gray-2);
	}
	.cols {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr));
		gap: 1rem;
	}
	.cols section {
		padding: 1rem 1.25rem;
		border: 1px solid var(--tg-rule);
		border-radius: 0.5rem;
		background: var(--tg-panel);
	}
	h2 {
		margin: 0 0 0.5rem;
		font-size: var(--sl-text-sm);
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: var(--sl-color-gray-3);
	}
	ul {
		margin: 0;
		padding-left: 1.1rem;
		display: grid;
		gap: 0.35rem;
	}
	p {
		margin: 0;
	}
	.first a {
		font-weight: 600;
		font-size: var(--sl-text-lg);
	}
	.assumed {
		grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
		gap: 0.35rem 1.5rem;
	}
	dl {
		display: grid;
		grid-template-columns: minmax(10rem, max-content) 1fr;
		gap: 0.5rem 1.5rem;
		margin: 0;
	}
	dt {
		color: var(--sl-color-gray-3);
	}
	dd {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1rem;
	}
	@media (max-width: 40rem) {
		dl {
			grid-template-columns: 1fr;
		}
		dd {
			margin-bottom: 0.5rem;
		}
	}
</style>
