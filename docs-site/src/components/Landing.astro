---
// The home page's two ends. `part="top"` (the default) is the wordmark, the
// tagline and what terragucci is; the cards that route by goal follow it in
// index.mdx. `part="agent"` is the prompt to hand a coding agent, further down
// the page: the setup prompt from src/prompts.ts, which the agents page and the
// README carry too. The tagline is the one the README and the site description
// use.
import AgentPrompt from './AgentPrompt.astro';
import { setupPrompt } from '../prompts';

interface Props {
	part?: 'top' | 'agent';
}
const { part = 'top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
{part === 'top' ? (
	<section class="tg-landing not-content">
		<p class="wordmark">TERRAGUCCI</p>

		<h1 class="claim">CI for Terraform, OpenTofu and Terragrunt, from the pull request to the drift check</h1>

		<p class="lede">
			One grouped plan note per pull request; <a href={`${base}/concepts/glossary/#root`}>roots</a> applied in waves, with a destroy waiting for an
			approval bound to its <a href={`${base}/concepts/glossary/#set-digest`}>set digest</a>; scheduled drift reports. CI does this: every
			job runs in your <a href={`${base}/concepts/glossary/#forge`}>forge's</a> CI and lands in your git and your bucket, with no account and
			no sign-in. <a href={`${base}/concepts/how-it-works/`}>How it works</a>.
		</p>
	</section>
) : (
	<section class="tg-landing tg-agent not-content">
		<AgentPrompt text={setupPrompt} />
	</section>
)}

<style>
	.tg-landing {
		display: grid;
		justify-items: center;
		gap: 2rem;
		padding-block: clamp(3rem, 10vw, 6rem) clamp(1rem, 3vw, 2rem);
		text-align: center;
	}
	.wordmark {
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 600;
		font-size: clamp(2.6rem, 9vw, 5.5rem);
		letter-spacing: 0.14em;
		line-height: 1;
		color: var(--sl-color-white);
		/* Optical centre: the tracking adds space after the last letter. */
		padding-left: 0.14em;
	}
	.claim {
		margin: 0;
		max-width: 34rem;
		font-family: var(--tg-display);
		font-weight: 500;
		font-size: clamp(1.25rem, 3vw, 1.7rem);
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.tg-agent {
		padding-block: 0;
	}
	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.lede a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
		white-space: nowrap;
	}
</style>
