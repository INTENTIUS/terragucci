---
// The home page's two ends. `part="top"` (the default) is the taco, the wordmark, the
// one-line claim, the door picker and the eight highlights, in the order the site leads with;
// index.mdx follows it with the plan note. `part="agent"` is the prompt to hand
// a coding agent, last on the page: the setup prompt from src/prompts.ts, which
// the agents page and the README carry too.
import AgentPrompt from './AgentPrompt.astro';
import DoorPicker from './DoorPicker.astro';
import Taco from './Taco.astro';
import { setupPrompt } from '../prompts';

interface Props {
	part?: 'top' | 'agent';
}
const { part = 'top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pillars = [
	{
		title: 'No server to host',
		links: [{ label: 'Components', href: '/concepts/how-it-works/#components' }],
	},
	{
		title: 'GitHub, GitLab or Forgejo',
		links: [{ label: 'Per forge', href: '/guides/add-to-a-repo/#per-forge' }],
	},
	{
		title: 'Object storage on AWS, GCP or Azure',
		links: [
			{ label: 'Credentials', href: '/reference/pipeline/#credentials' },
			{ label: 'Reports bucket', href: '/guides/keep-reports-in-a-bucket/' },
		],
	},
	{
		title: 'Tracing and metrics',
		links: [{ label: 'Send traces and metrics', href: '/guides/send-traces-and-metrics/' }],
	},
	{
		title: 'Rich lifecycles',
		links: [{ label: 'The lifecycle', href: '/concepts/how-it-works/' }],
	},
	{
		title: 'Gated waves',
		links: [{ label: 'Waves and approvals', href: '/concepts/waves-and-approvals/' }],
	},
	{
		title: 'Aggregated plan output',
		links: [{ label: 'Grouped plans', href: '/concepts/why-plans-are-grouped/' }],
	},
	{
		title: 'Module publishing and pinned rollouts',
		links: [
			{ label: 'Publish modules', href: '/guides/publish-modules/' },
			{ label: 'Roll out a version', href: '/guides/roll-out-a-module-version/' },
		],
	},
];
---
{part === 'top' ? (
	<section class="tg-landing not-content">
		<Taco scale={2} class="hero-taco" />
		<h1 class="wordmark">TERRAGUCCI</h1>
		<p class="claim">Plans, gated applies and drift for Terraform and OpenTofu, in your own CI, open source under Apache-2.0.</p>
	</section>
	<DoorPicker />
	<ul class="tg-pillars not-content">
		{pillars.map((p) => (
			<li>
				<Taco />
				<h2>{p.title}</h2>
				<span class="links">
					{p.links.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
				</span>
			</li>
		))}
	</ul>
) : (
	<section class="tg-landing tg-agent not-content">
		<AgentPrompt text={setupPrompt} label="Hand the setup to your coding agent" note="Or set up by hand: install terragucci and run init, as the getting started page shows." />
	</section>
)}

<style>
	.tg-landing {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 1rem;
		text-align: center;
	}
	.tg-landing :global(.hero-taco img) {
		width: 96px;
	}
	.wordmark {
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 600;
		font-size: clamp(1.25rem, 3.5vw, 1.6rem);
		letter-spacing: 0.14em;
		line-height: 1;
		color: var(--sl-color-white);
		/* Optical centre: the tracking adds space after the last letter. */
		padding-left: 0.14em;
	}
	.claim {
		margin: 0;
		max-width: 46rem;
		font-family: var(--tg-display);
		font-weight: 500;
		font-size: var(--sl-text-base);
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.tg-agent {
		padding-block: 0;
	}
	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.proof {
		margin: 0;
		max-width: 40rem;
		font-size: 0.9rem;
		color: var(--sl-color-gray-3);
	}
	.proof a,
	.lede a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
		white-space: nowrap;
	}
	.tg-pillars {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: 1rem;
	}
	.tg-pillars li {
		margin: 0;
		padding: 1.5rem;
		display: grid;
		gap: 0.75rem;
		align-content: start;
		border: 1px solid var(--tg-rule);
		border-top: 3px solid var(--tg-accent);
		border-radius: 0.5rem;
		background: var(--tg-panel);
		min-width: 0;
	}
	.tg-pillars h2 {
		margin: 0;
		font-family: var(--tg-display);
		font-size: var(--sl-text-lg);
		font-weight: 600;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.tg-pillars p {
		margin: 0;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}
	.tg-pillars .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		font-size: 0.9rem;
	}
	.tg-pillars a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
	}
</style>
