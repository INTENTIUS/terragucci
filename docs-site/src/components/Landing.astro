---
// The home page's two ends. `part="top"` (the default) is the taco, the wordmark, the
// one-line claim, the door picker and the eight highlights, in the order the site leads with;
// index.mdx follows it with the plan note. `part="agent"` is the prompt to hand
// a coding agent, last on the page: the setup prompt from src/prompts.ts, which
// the agents page and the README carry too.
import AgentPrompt from './AgentPrompt.astro';
import DoorPicker from './DoorPicker.astro';
import Taco from './Taco.astro';
import { setupPrompt } from '../prompts';

interface Props {
	part?: 'top' | 'agent';
}
const { part = 'top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
// The eight highlights: each card is one link, its title the whole label.
const pillars = [
	{ title: 'No server to host', href: '/concepts/how-it-works/#components' },
	{ title: 'GitHub, GitLab or Forgejo', href: '/guides/add-to-a-repo/#per-forge' },
	{ title: 'Object storage on AWS, GCP or Azure', href: '/guides/keep-reports-in-a-bucket/' },
	{ title: 'Tracing and metrics', href: '/guides/send-traces-and-metrics/' },
	{ title: 'Rich lifecycles', href: '/concepts/how-it-works/' },
	{ title: 'Gated waves', href: '/concepts/waves-and-approvals/' },
	{ title: 'Aggregated plan output', href: '/concepts/why-plans-are-grouped/' },
	{ title: 'Module publishing and pinned rollouts', href: '/guides/publish-modules/' },
];
---
{part === 'top' ? (
	<section class="tg-landing not-content">
		<Taco scale={2} class="hero-taco" />
		<h1 class="wordmark">TERRAGUCCI</h1>
		<p class="claim">Sophisticated automation for Terraform</p>
	</section>
	<DoorPicker />
	<ul class="tg-pillars not-content">
		{pillars.map((p) => (
			<li>
				<a href={`${base}${p.href}`}>
					<Taco />
					<span>{p.title}</span>
				</a>
			</li>
		))}
	</ul>
) : (
	<section class="tg-landing tg-agent not-content">
		<AgentPrompt text={setupPrompt} label="Hand the setup to your coding agent" note="Or set up by hand: install terragucci and run init, as the getting started page shows." />
	</section>
)}

<style>
	.tg-landing {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		padding-block: clamp(1.5rem, 4vw, 2.5rem) 1rem;
		text-align: center;
	}
	.tg-landing :global(.hero-taco img) {
		width: 96px;
	}
	.tg-landing .wordmark {
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 500;
		font-size: clamp(1.25rem, 3.5vw, 1.6rem);
		letter-spacing: 0.32em;
		line-height: 1;
		color: var(--sl-color-white);
		/* Optical centre: the tracking adds space after the last letter. */
		padding-left: 0.32em;
	}
	.claim {
		display: grid;
		justify-items: center;
		gap: 0.9rem;
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 400;
		font-size: 0.78rem;
		line-height: 1.3;
		letter-spacing: 0.22em;
		text-transform: uppercase;
		color: var(--sl-color-gray-3);
	}
	/* A gold hairline between the wordmark and the line under it. */
	@media (max-width: 30rem) {
		.claim {
			letter-spacing: 0.14em;
		}
	}
	.claim::before {
		content: '';
		width: 2.5rem;
		height: 1px;
		background: var(--tg-gold);
	}
	.tg-agent {
		padding-block: 0;
	}
	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.proof {
		margin: 0;
		max-width: 40rem;
		font-size: 0.9rem;
		color: var(--sl-color-gray-3);
	}
	.proof a,
	.lede a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
		white-space: nowrap;
	}
	.tg-pillars {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 0.75rem;
	}
	.tg-pillars li {
		margin: 0;
		min-width: 0;
	}
	.tg-pillars a {
		display: grid;
		gap: 0.6rem;
		justify-items: start;
		height: 100%;
		padding: 1.1rem 1.15rem;
		font-family: var(--tg-display);
		font-size: var(--sl-text-sm);
		font-weight: 600;
		line-height: 1.3;
		color: var(--sl-color-white);
		text-decoration: none;
		border: 1px solid var(--tg-rule);
		border-top: 1px solid var(--tg-gold);
		border-radius: 0.5rem;
		background: var(--tg-panel);
		transition: border-color 0.15s;
	}
	.tg-pillars a:hover,
	.tg-pillars a:focus-visible {
		border-color: var(--tg-gold);
	}
	@media (max-width: 50rem) {
		.tg-pillars {
			grid-template-columns: repeat(2, 1fr);
			gap: 0.5rem;
		}
		.tg-pillars a {
			padding: 0.85rem;
			font-size: var(--sl-text-xs);
		}
	}
</style>
