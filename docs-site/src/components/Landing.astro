---
// The home page's two ends. `part="top"` (the default) is the wordmark, the
// tagline, the one-sentence position, the proof line and the three pillars;
// index.mdx follows it with the plan note. `part="agent"` is the prompt to hand
// a coding agent, last on the page: the setup prompt from src/prompts.ts, which
// the agents page and the README carry too. The tagline is the one the README
// and the site description use.
import AgentPrompt from './AgentPrompt.astro';
import { setupPrompt } from '../prompts';

interface Props {
	part?: 'top' | 'agent';
}
const { part = 'top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pillars = [
	{
		title: 'No server to host',
		text: 'Every job runs in your CI. State, plan reports and approvals stay in your git and your bucket.',
		links: [
			{ label: 'What runs where', href: '/concepts/how-it-works/#what-runs-where' },
			{ label: 'The lifecycle', href: '/concepts/how-it-works/' },
		],
	},
	{
		title: 'Built for many roots',
		text: 'One grouped note for 200 plans. Canary roots apply first, then the rest in waves. An approval covers exactly the plans it was shown, and a plan that changed after it is refused.',
		links: [
			{ label: 'Grouped plans', href: '/concepts/why-plans-are-grouped/' },
			{ label: 'Waves and approvals', href: '/concepts/waves-and-approvals/' },
		],
	},
	{
		title: 'A trace of every run',
		text: 'One OpenTelemetry trace per stage run, with a span per root and the binary\'s own spans inside it. With choudoufu those show lock waits and slow provider calls. Metrics and dashboards come with it.',
		links: [
			{ label: 'Send traces and metrics', href: '/guides/send-traces-and-metrics/' },
			{ label: 'What a trace holds', href: '/reference/observability/#the-trace' },
		],
	},
];
---
{part === 'top' ? (
	<section class="tg-landing not-content">
		<p class="wordmark">TERRAGUCCI</p>

		<h1 class="claim">Plan, approve and apply hundreds of Terraform, OpenTofu and Terragrunt roots from pull requests, in your own CI, with a trace of every run.</h1>

		<p class="lede">
			CI does this: each job runs in your GitHub, GitLab or Forgejo CI and lands in your git and your bucket, with no account
			to create and no platform to sign in to.
		</p>

		<p class="proof">
			Every pipeline feature on this site is proven by a recorded claim that fails when broken
			(<a href={`${base}/reference/validation/`}>validation</a>). Apache-2.0, nothing to buy.
		</p>
	</section>
	<ul class="tg-pillars not-content">
		{pillars.map((p) => (
			<li>
				<h2>{p.title}</h2>
				<p>{p.text}</p>
				<span class="links">
					{p.links.map((l) => <a href={`${base}${l.href}`}>{l.label}</a>)}
				</span>
			</li>
		))}
	</ul>
) : (
	<section class="tg-landing tg-agent not-content">
		<AgentPrompt text={setupPrompt} label="Optional: hand the setup to your coding agent" note="Setup works by hand too: install terragucci and run init, as the getting started page shows." />
	</section>
)}

<style>
	.tg-landing {
		display: grid;
		justify-items: center;
		gap: 2rem;
		padding-block: clamp(3rem, 10vw, 6rem) clamp(1rem, 3vw, 2rem);
		text-align: center;
	}
	.wordmark {
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 600;
		font-size: clamp(2.6rem, 9vw, 5.5rem);
		letter-spacing: 0.14em;
		line-height: 1;
		color: var(--sl-color-white);
		/* Optical centre: the tracking adds space after the last letter. */
		padding-left: 0.14em;
	}
	.claim {
		margin: 0;
		max-width: 46rem;
		font-family: var(--tg-display);
		font-weight: 500;
		font-size: clamp(1.25rem, 3vw, 1.7rem);
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.tg-agent {
		padding-block: 0;
	}
	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.proof {
		margin: 0;
		max-width: 40rem;
		font-size: 0.9rem;
		color: var(--sl-color-gray-3);
	}
	.proof a,
	.lede a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
		white-space: nowrap;
	}
	.tg-pillars {
		list-style: none;
		margin: 1rem 0 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(16rem, 100%), 1fr));
		gap: 1rem;
	}
	.tg-pillars li {
		margin: 0;
		padding: 1.5rem;
		display: grid;
		gap: 0.75rem;
		align-content: start;
		border: 1px solid var(--tg-rule);
		border-top: 3px solid var(--tg-accent);
		border-radius: 0.5rem;
		background: var(--tg-panel);
		min-width: 0;
	}
	.tg-pillars h2 {
		margin: 0;
		font-family: var(--tg-display);
		font-size: clamp(1.3rem, 2.5vw, 1.6rem);
		font-weight: 600;
		line-height: 1.2;
		color: var(--sl-color-white);
	}
	.tg-pillars p {
		margin: 0;
		color: var(--sl-color-gray-2);
		line-height: 1.55;
	}
	.tg-pillars .links {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem 1rem;
		font-size: 0.9rem;
	}
	.tg-pillars a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
	}
</style>
