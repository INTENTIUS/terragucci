---
// The home page's two ends. `part="top"` (the default) is the wordmark, the
// tagline, what terragucci is and the three ways in. `part="agent"` is the
// prompt to hand a coding agent, further down the page. The prompt is the same
// one the agents page and the README carry. The tagline is the one the README
// and the site description use.
interface Props {
	part?: 'top' | 'agent';
}
const { part = 'top' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const paths = [
	{ href: `${base}/tutorial/`, label: 'Try it on your laptop', detail: 'A 15-root example with a local forge and an AWS stand-in, booted with one command.' },
	{ href: `${base}/getting-started/`, label: 'Set it up in your repo', detail: 'npm i -D @intentius/terragucci, npx terragucci init, and a plan note on your next pull request.' },
	{ href: `${base}/getting-started/agents/`, label: 'Let your agent do it', detail: 'A prompt for Claude Code, Codex or Cursor. The agent opens a pull request and never applies or approves.' },
];
const prompt = [
	'Set up terragucci in this repository.',
	'Read https://intentius.io/terragucci/llms.txt first, then',
	'https://intentius.io/terragucci/getting-started/agents/ and follow it.',
	'Do not apply anything. Open a pull request with the result.',
].join('\n');
---
{part === 'top' ? (
	<section class="tg-landing not-content">
		<p class="wordmark">TERRAGUCCI</p>

		<h1 class="claim">CI for Terraform, OpenTofu and Terragrunt, from the pull request to the drift check</h1>

		<p class="lede">
			terragucci writes the pipeline your forge runs. Every pull request gets one grouped plan note. Every merge
			applies in waves, and a wave that destroys something waits for a signed approval. A scheduled job reports drift. It runs on your own GitHub,
			GitLab or Forgejo runners with your cloud roles. There is no server to run and no service to pay for.
			<a href={`${base}/concepts/how-it-works/`}>How it works</a>
		</p>

		<ul class="paths">
			{paths.map((p) => (
				<li>
					<a href={p.href}>{p.label}</a>
					<p>{p.detail}</p>
				</li>
			))}
		</ul>
	</section>
) : (
	<section class="tg-landing tg-agent not-content">
		<figure class="agent">
			<figcaption>
				<span>Paste into your coding agent</span>
				<button type="button" class="copy" data-copy={prompt} aria-label="Copy the prompt">Copy</button>
			</figcaption>
			<pre><code>{prompt}</code></pre>
		</figure>
	</section>
)}

<script>
	for (const button of document.querySelectorAll<HTMLButtonElement>('.tg-landing .copy')) {
		button.addEventListener('click', async () => {
			const text = button.dataset.copy ?? '';
			try {
				await navigator.clipboard.writeText(text);
				button.textContent = 'Copied';
			} catch {
				const code = button.closest('figure')?.querySelector('code');
				if (code) window.getSelection()?.selectAllChildren(code);
				button.textContent = 'Selected';
			}
			setTimeout(() => (button.textContent = 'Copy'), 1600);
		});
	}
</script>

<style>
	.tg-landing {
		display: grid;
		justify-items: center;
		gap: 2rem;
		padding-block: clamp(3rem, 10vw, 6rem) clamp(2rem, 6vw, 4rem);
		text-align: center;
	}
	.wordmark {
		margin: 0;
		font-family: var(--tg-display);
		font-weight: 600;
		font-size: clamp(2.6rem, 9vw, 5.5rem);
		letter-spacing: 0.14em;
		line-height: 1;
		color: var(--sl-color-white);
		/* Optical centre: the tracking adds space after the last letter. */
		padding-left: 0.14em;
	}
	.agent {
		margin: 0;
		width: min(100%, 44rem);
		text-align: left;
		border: 1px solid var(--tg-rule);
		border-radius: 0.75rem;
		background: var(--tg-panel);
		overflow: hidden;
	}
	figcaption {
		display: flex;
		justify-content: space-between;
		align-items: center;
		gap: 1rem;
		padding: 0.6rem 0.9rem;
		border-bottom: 1px solid var(--tg-rule);
		font-size: 0.8rem;
		color: var(--sl-color-gray-3);
	}
	.copy {
		font: inherit;
		font-weight: 500;
		color: var(--sl-color-white);
		background: var(--sl-color-gray-6);
		border: 1px solid var(--tg-rule);
		border-radius: 0.4rem;
		padding: 0.2rem 0.7rem;
		cursor: pointer;
	}
	.copy:hover {
		border-color: var(--tg-accent);
	}
	pre {
		margin: 0;
		padding: 1rem 1.1rem;
		overflow-x: auto;
		font-family: var(--sl-font-mono);
		font-size: 0.85rem;
		line-height: 1.65;
		color: var(--sl-color-gray-1);
		white-space: pre;
	}
	@media (max-width: 40rem) {
		pre {
			white-space: pre-wrap;
			overflow-wrap: anywhere;
		}
	}
	.claim {
		margin: 0;
		max-width: 34rem;
		font-family: var(--tg-display);
		font-weight: 500;
		font-size: clamp(1.25rem, 3vw, 1.7rem);
		line-height: 1.3;
		letter-spacing: -0.015em;
		color: var(--sl-color-gray-2);
		text-wrap: balance;
	}
	.tg-agent {
		padding-block: 0;
	}
	.lede {
		margin: 0;
		max-width: 40rem;
		color: var(--sl-color-gray-2);
		line-height: 1.6;
		text-wrap: pretty;
	}
	.lede a {
		color: var(--sl-color-accent-high);
		font-weight: 500;
		white-space: nowrap;
	}
	.paths {
		list-style: none;
		margin: 0;
		padding: 0;
		width: min(100%, 52rem);
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(min(14rem, 100%), 1fr));
		gap: 1rem;
		text-align: left;
	}
	.paths li {
		margin: 0;
		padding: 1rem 1.1rem;
		border: 1px solid var(--tg-rule);
		border-radius: 0.75rem;
		background: var(--tg-panel);
		display: grid;
		gap: 0.4rem;
		align-content: start;
		min-width: 0;
	}
	.paths a {
		font-family: var(--tg-display);
		font-size: 1.1rem;
		font-weight: 600;
		color: var(--sl-color-accent-high);
		text-decoration: none;
	}
	.paths a:hover {
		text-decoration: underline;
	}
	.paths p {
		margin: 0;
		font-size: 0.9rem;
		color: var(--sl-color-gray-2);
		overflow-wrap: anywhere;
	}
</style>
