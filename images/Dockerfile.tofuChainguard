RUN set -e; a="$TARGETARCH" && case "$a" in (amd64) w=amd64 ;; (arm64) w=arm64 ;; (*) echo "tofu 1.13.1: chant fetches it for amd64 and arm64, not $a" >&2; exit 1 ;; esac && f="tofu_1.13.1_linux_$w.tar.gz" && t="$(mktemp -d)" && curl -fsSLo "$t/$f" "https://github.com/opentofu/opentofu/releases/download/v1.13.1/$f" && case "$a" in (amd64) want=378ada19d4bc70c43732004e8159be771b23b9a5afdf059e5f8a2b3fa2c70a69 ;; (arm64) want=9c1ef375aa1852db0b2888aa921b640c71f8140d4682aa4fec99378a64fa7dc3 ;; (*) want= ;; esac && curl -fsSLo "$t/sums" "https://github.com/opentofu/opentofu/releases/download/v1.13.1/tofu_1.13.1_SHA256SUMS" && line="$(sed -n "s#^\([0-9a-f]\{64\}\)  *[*.]*/*$f\$#\1#p" "$t/sums")" && { [ -n "$line" ] || { echo "tofu 1.13.1: $f is not in tofu_1.13.1_SHA256SUMS" >&2; exit 1; }; } && { [ -z "$want" ] || [ "$line" = "$want" ] || { echo "tofu 1.13.1: tofu_1.13.1_SHA256SUMS lists $line for $f; chant records $want" >&2; exit 1; }; } && want="$line" && echo "$want  $t/$f" | sha256sum -c - >/dev/null && mkdir -p "/opt/terragucci/tofu-1.13.1" && tar -xzf "$t/$f" -C "$t" "tofu" && install -m 0755 "$t/tofu" "/opt/terragucci/tofu-1.13.1/tofu"
FROM cgr.dev/chainguard/node:latest-dev@sha256:cd993dc8ec644f8f35e8356f6b442e807cdc5e42f303da5ce19a55d7cf660b51
USER root
ARG CHANT_RELEASE_LABEL
ENV USER=terragucci
ENV HOME=/tmp
ENV NODE_DISABLE_COMPILE_CACHE=1
ENV npm_config_logs_max=0
ENV CHANT_IMAGE_USER=65532
RUN apk add --no-cache git=2.56.1-r1 ca-certificates=20261020-r0 || { echo "apk add failed. If Wolfi no longer serves a pinned version, move the pin: a newer chant moves its own (WOLFI_PACKAGE_PINS), and chant release images --repin <file> moves an apk:<name>=<version> entry in your source; then render this Dockerfile again." >&2; exit 1; } && mkdir -p /usr/local/bin
RUN git config --system --add safe.directory '*'
RUN npm install --prefix /usr/local --no-save --omit=dev --no-audit --no-fund @intentius/chant@0.124.112 @cdktn/hcl2json@0.24.0 && npm cache clean --force && rm -rf /tmp/.npm
RUN cd /tmp && npm pack --silent @intentius/chant@0.124.112 && tar -xzf intentius-chant-0.124.112.tgz package/dist/wave-runtime.mjs && install -D -m 0644 package/dist/wave-runtime.mjs /opt/chant/wave-runtime.mjs && printf '#!/bin/sh\nexec node /opt/chant/wave-runtime.mjs "$@"\n' > /usr/local/bin/chant && chmod 0755 /usr/local/bin/chant && rm -rf /tmp/package /tmp/intentius-chant-*.tgz && npm cache clean --force && rm -rf /tmp/.npm
COPY --from=fetch /opt/terragucci/ /opt/terragucci/
RUN ln -sf /opt/terragucci/tofu-1.13.1/tofu /usr/local/bin/tofu
RUN mkdir -p /opt/terragucci && chown 65532:65532 /opt/terragucci
COPY --chmod=0755 packages/terragucci/dist/terragucci.mjs /usr/local/bin/terragucci
LABEL org.opencontainers.image.title="terragucci-tofu"
LABEL org.opencontainers.image.description="OpenTofu 1.13.1 and the terragucci engine, on Chainguard images"
