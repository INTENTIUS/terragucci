FROM cgr.dev/chainguard/wolfi-base:latest@sha256:be019c1c74fe69204a42c4e10bc4d886a49bf5403ffa74374ef7baa408fc9a26 AS fetch
ARG TARGETARCH
RUN apk add --no-cache ca-certificates curl unzip
RUN set -e; a="$TARGETARCH" && case "$a" in (amd64) w=amd64 ;; (arm64) w=arm64 ;; (*) echo "terraform 1.14.9: chant fetches it for amd64 and arm64, not $a" >&2; exit 1 ;; esac && f="terraform_1.14.9_linux_$w.zip" && t="$(mktemp -d)" && curl -fsSLo "$t/$f" "https://releases.hashicorp.com/terraform/1.14.9/$f" && case "$a" in (amd64) want=2e5cffc20a0b48a67a76268723bd5a10b8666f69b2aa4f04906e206726bedd63 ;; (arm64) want=863002085b886453795d9ff4b8989b8468784478150b70ba8a1df3e3ad66da99 ;; (*) want= ;; esac && curl -fsSLo "$t/sums" "https://releases.hashicorp.com/terraform/1.14.9/terraform_1.14.9_SHA256SUMS" && line="$(sed -n "s#^\([0-9a-f]\{64\}\)  *[*.]*/*$f\$#\1#p" "$t/sums")" && { [ -n "$line" ] || { echo "terraform 1.14.9: $f is not in terraform_1.14.9_SHA256SUMS" >&2; exit 1; }; } && { [ -z "$want" ] || [ "$line" = "$want" ] || { echo "terraform 1.14.9: terraform_1.14.9_SHA256SUMS lists $line for $f; chant records $want" >&2; exit 1; }; } && want="$line" && echo "$want  $t/$f" | sha256sum -c - >/dev/null && mkdir -p "/opt/terragucci/terraform-1.14.9" && unzip -q -o "$t/$f" "terraform" -d "$t" && install -m 0755 "$t/terraform" "/opt/terragucci/terraform-1.14.9/terraform"
FROM cgr.dev/chainguard/node:latest-dev@sha256:cd993dc8ec644f8f35e8356f6b442e807cdc5e42f303da5ce19a55d7cf660b51
USER root
ARG CHANT_RELEASE_LABEL
ENV USER=terragucci
ENV HOME=/tmp
ENV NODE_DISABLE_COMPILE_CACHE=1
ENV npm_config_logs_max=0
ENV CHANT_IMAGE_USER=65532
RUN apk add --no-cache git ca-certificates && mkdir -p /usr/local/bin
RUN git config --system --add safe.directory '*'
RUN npm install --prefix /usr/local --no-save --omit=dev --no-audit --no-fund @intentius/chant@0.124.112 @cdktn/hcl2json@0.24.0 && npm cache clean --force && rm -rf /tmp/.npm
RUN cd /tmp && npm pack --silent @intentius/chant@0.124.112 && tar -xzf intentius-chant-0.124.112.tgz package/dist/wave-runtime.mjs && install -D -m 0644 package/dist/wave-runtime.mjs /opt/chant/wave-runtime.mjs && printf '#!/bin/sh\nexec node /opt/chant/wave-runtime.mjs "$@"\n' > /usr/local/bin/chant && chmod 0755 /usr/local/bin/chant && rm -rf /tmp/package /tmp/intentius-chant-*.tgz && npm cache clean --force && rm -rf /tmp/.npm
COPY --from=fetch /opt/terragucci/ /opt/terragucci/
RUN ln -sf /opt/terragucci/terraform-1.14.9/terraform /usr/local/bin/terraform
RUN mkdir -p /opt/terragucci && chown 65532:65532 /opt/terragucci
COPY --chmod=0755 packages/terragucci/dist/terragucci.mjs /usr/local/bin/terragucci
LABEL org.opencontainers.image.title="terragucci-terraform"
LABEL org.opencontainers.image.description="Terraform 1.14.9 and the terragucci engine, on Chainguard images"
LABEL org.opencontainers.image.version="${CHANT_RELEASE_LABEL}"
LABEL org.opencontainers.image.source="https://github.com/INTENTIUS/terragucci"
LABEL org.opencontainers.image.licenses="Apache-2.0"
LABEL org.opencontainers.image.base.name="cgr.dev/chainguard/node:latest-dev"
LABEL org.opencontainers.image.base.digest="sha256:cd993dc8ec644f8f35e8356f6b442e807cdc5e42f303da5ce19a55d7cf660b51"
LABEL io.intentius.chant.image.base="chainguard"
ENTRYPOINT []
CMD ["bash"]
USER 65532
